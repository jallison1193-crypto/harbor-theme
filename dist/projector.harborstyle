# Harbor Style
name: Projector
blurb: A dark room lit by the artwork. Film stocks, light or dark or time of day. Press Alt+T.
layout: sidebar
card: flat
button: flat
font: general-sans
bokeh: false
swatch: #131314, #212124, #e9c37f

@tokens
--color-canvas: #131314
--color-surface: #19191b
--color-elevated: #212124
--color-raised: #2a2a2e
--color-ink: #efeee9
--color-ink-muted: #a8a7a1
--color-ink-subtle: #8a8983
--color-edge: #efeee91a
--color-edge-soft: #efeee90f
--color-accent: #e9c37f
--color-accent-soft: #e9c37f2e
--color-danger: #f0716b

@css
/* Projector for Harbor.
   A dark room lit by the artwork. Colors come from js/00-core.js, which writes Harbor's 12 tokens for the chosen
   appearance and film stock. Performance rules (docs/projector-plan.md, section 5): only transform and opacity
   animate, no backdrop-filter, costly images are drawn once and then only moved or faded.
   The stylesheet is built by joining projector/src/css/*.css in name order (build/build.mjs).
   Fragile rules (anything that depends on Harbor's internal utility classes) sit at the end of each file under a
   "Fragile" heading, each with the Harbor version it was checked against. */

/* 1. Variables and film stocks ------------------------------------------ */
/* Tokens and fonts are written by js/00-core.js into <style id="projector-vars">. These are Projector's own. */
html[data-pj] {
  --pj-r-poster: 6px;
  --pj-r-md: 12px;
  --pj-r-sm: 8px;
  --pj-ease: cubic-bezier(.22, .61, .36, 1);
}

/* 2. Appearance modes ---------------------------------------------------- */
/* Harbor keeps html, body and #root transparent and paints the canvas itself (ThemeBackdrop). The body gets the canvas
   only while no player is mounted: on Windows the video is a native mpv layer behind the transparent web view, so any
   opaque body would cover playback. */
html[data-pj]:not(:has([data-harbor-player])) body { background: var(--color-canvas); }
html:has([data-harbor-player]) body { background: transparent !important; }

/* 3. Projector's own layers (spill, house lights, grain): milestone 2 ----- */
/* Every layer steps aside while Harbor's player is mounted: on Windows the video can be a native layer
   behind a transparent web view, so anything painted here would cover it. */
html:has([data-harbor-player]) [id^="projector-layer"] { display: none !important; }

/* 10. Type, performance and motion --------------------------------------- */
html[data-pj] .font-display {
  font-weight: var(--pj-d-weight);
  font-stretch: var(--pj-d-stretch);
  letter-spacing: var(--pj-d-track);
}
html[data-pj][data-pj-motion="off"] *,
html[data-pj][data-pj-motion="off"] *::before,
html[data-pj][data-pj-motion="off"] *::after {
  animation-duration: 1ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 1ms !important;
}

/* Fragile rules live at the end of each css/ file under a "Fragile" heading. Harbor's hover preview (fixed layer at
   z-[110]) and screensaver have no stable selectors; their rules go in css/40-features.css under that heading. */

/* 4. Navigation: Marquee -------------------------------------------------
   Styles Harbor's own sidebar (layout "sidebar": aside[data-harbor-sidebar], 72px icons, 240px with labels from
   1024px). The sidebar is lit by what is showing: a faint accent tint at the top, a "Now showing" thumbnail of the
   banner (js/20-nav.js), and the current page lit by a lamp. Group headings depend on Harbor's internal classes, so
   they are under Fragile at the end of this file. Nothing here animates except opacity. */
html[data-pj] aside[data-harbor-sidebar] {
  container: pj-side / inline-size;
  background-color: var(--color-canvas);
  background-image: radial-gradient(140% 46% at 0 0, color-mix(in srgb, var(--color-accent) 13%, var(--color-canvas)), var(--color-canvas) 72%);
}
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav] {
  height: 38px;
  border-radius: var(--pj-r-sm);
  font-size: 14px;
  font-weight: 500;
  color: var(--color-ink-muted);
  background-color: transparent;
}
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav]:hover { color: var(--color-ink); background-color: color-mix(in srgb, var(--color-ink) 6%, transparent); }
/* the lit page: a lamp on the left edge throwing accent light across the row */
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav][data-active] {
  color: var(--color-ink);
  background-color: transparent;
  background-image: linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 24%, transparent), color-mix(in srgb, var(--color-accent) 5%, transparent) 70%, transparent);
}
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav]::before {
  content: ""; position: absolute; left: 0; top: 50%; width: 3px; height: 18px; margin-top: -9px;
  border-radius: 0 2px 2px 0; background: var(--color-accent); pointer-events: none; opacity: 0;
  box-shadow: 0 0 10px 1px var(--color-accent), 0 0 22px 2px color-mix(in srgb, var(--color-accent) 45%, transparent);
  transition: opacity .25s var(--pj-ease);
}
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav][data-active]::before { opacity: 1; }
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav][data-active] svg { opacity: 1; color: var(--color-accent); }
html[data-pj] aside[data-harbor-sidebar] [data-harbor-nav]:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

/* "Now showing": built by js/20-nav.js, placed under Harbor's logo, only when the sidebar shows labels */
#projector-now { display: none; }
@container pj-side (min-width: 180px) {
  #projector-now:not([hidden]) { display: grid; gap: 4px; margin: 6px 16px 4px; }
}
/* Shorter windows: a compact row (small thumbnail beside the title) so every page still fits without scrolling. */
@media (max-height: 1000px) {
  @container pj-side (min-width: 180px) {
    #projector-now:not([hidden]) { grid-template-columns: 76px minmax(0, 1fr); column-gap: 10px; row-gap: 2px; align-content: center; margin-top: 2px; }
    #projector-now .pj-now-art { grid-row: span 2; margin-bottom: 0; }
    #projector-now .pj-now-kicker { align-self: end; }
    #projector-now .pj-now-title { align-self: start; font-size: 15px; line-height: 19px; }
  }
}
#projector-now .pj-now-art {
  position: relative; aspect-ratio: 16 / 9; margin-bottom: 4px; overflow: hidden; border-radius: var(--pj-r-sm); background: #000;
  box-shadow: 0 10px 28px -12px color-mix(in srgb, var(--color-accent) 70%, transparent), inset 0 0 0 1px rgb(255 255 255 / .06);
}
#projector-now img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: var(--pj-grade); }
#projector-now.pj-swap img, #projector-now.pj-swap .pj-now-title { animation: pj-fade .6s var(--pj-ease) both; }
#projector-now .pj-now-kicker { margin: 0; font-size: 11px; line-height: 14px; font-weight: 600; color: var(--color-accent); }
#projector-now .pj-now-title {
  margin: 0; font-family: var(--font-display); font-weight: var(--pj-d-weight); font-stretch: var(--pj-d-stretch); letter-spacing: var(--pj-d-track);
  font-size: 17px; line-height: 21px; color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
@keyframes pj-fade { from { opacity: 0; } to { opacity: 1; } }

/* Navigation bar at the top or bottom (data-pj-nav, set from the panel's Look tab by js/20-nav.js). Harbor's own
   sidebar is laid out as a row: its shell turns from a row into a column, the aside spans the window, and every
   group inside it runs sideways. Marquee (names) or Icons is still Harbor's own collapse setting. "Now showing" and
   the group headings belong to the vertical sidebar, so the bar drops its container query and they stay hidden.
   Class names here follow Harbor 1.0.3 chrome/sidebar.tsx and are Fragile. */
html[data-pj-nav="top"] [data-harbor-native-backdrop]:has(> aside[data-harbor-sidebar]) { flex-direction: column; }
html[data-pj-nav="bottom"] [data-harbor-native-backdrop]:has(> aside[data-harbor-sidebar]) { flex-direction: column-reverse; }
html[data-pj-nav="top"] aside[data-harbor-sidebar],
html[data-pj-nav="bottom"] aside[data-harbor-sidebar] {
  container-type: normal;
  width: 100% !important; height: 60px; flex-direction: row; align-items: center; gap: 6px; padding-inline: 10px;
  border-inline-end: 0 !important;
  background-image: radial-gradient(60% 140% at 0 0, color-mix(in srgb, var(--color-accent) 12%, var(--color-canvas)), var(--color-canvas) 70%);
}
html[data-pj-nav="top"] aside[data-harbor-sidebar] { border-bottom: 1px solid var(--color-edge-soft); }
html[data-pj-nav="bottom"] aside[data-harbor-sidebar] { border-top: 1px solid var(--color-edge-soft); }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-brand] {
  height: 100% !important; flex: none; padding-inline: 6px 4px;
}
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) #projector-now { display: none !important; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > div:has(> .overflow-y-auto) {
  flex-direction: row; min-width: 0; height: 100%;
}
/* Harbor's scroll fades and arrows are for a vertical list. */
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > div:has(> .overflow-y-auto) > :not(.overflow-y-auto) { display: none !important; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] .overflow-y-auto {
  flex-direction: row; align-items: center; gap: 4px; padding: 0 6px !important;
  overflow-x: auto; overflow-y: hidden; scrollbar-width: none;
}
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] .overflow-y-auto > .flex-col { flex-direction: row; flex: none; gap: 2px; }
/* Harbor's group divider becomes a short upright line. */
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region]:not(.flex-1) {
  flex: none; width: 1px; height: 22px !important; margin-inline: 8px; padding: 0 !important; background: var(--color-edge-soft);
}
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region]:not(.flex-1) > * { display: none; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region].flex-1 { align-self: stretch; min-width: 16px; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] [data-harbor-nav] {
  flex: none; width: auto; height: 40px; padding-inline: 12px !important; gap: 10px; justify-content: center;
}
/* The lamp moves to the edge that faces the page: under the item on a top bar, over it on a bottom bar. */
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] [data-harbor-nav]::before {
  left: 50%; width: 18px; height: 3px; margin: 0 0 0 -9px;
}
html[data-pj-nav="top"] aside[data-harbor-sidebar] [data-harbor-nav]::before { top: auto; bottom: -1px; border-radius: 2px 2px 0 0; }
html[data-pj-nav="bottom"] aside[data-harbor-sidebar] [data-harbor-nav]::before { top: -1px; border-radius: 0 0 2px 2px; }
html[data-pj-nav="top"] aside[data-harbor-sidebar] [data-harbor-nav][data-active] {
  background-image: linear-gradient(to top, color-mix(in srgb, var(--color-accent) 24%, transparent), color-mix(in srgb, var(--color-accent) 4%, transparent) 75%, transparent);
}
html[data-pj-nav="bottom"] aside[data-harbor-sidebar] [data-harbor-nav][data-active] {
  background-image: linear-gradient(to bottom, color-mix(in srgb, var(--color-accent) 24%, transparent), color-mix(in srgb, var(--color-accent) 4%, transparent) 75%, transparent);
}
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] {
  flex: none; display: flex; flex-direction: row; align-items: center; gap: 4px; padding: 0 !important;
}
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] > * { margin: 0 !important; padding: 0 !important; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] > .flex-col { flex-direction: row; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] :is(button, a) { height: 40px; }
/* Room for the pages: the bar keeps Harbor's mark without the wordmark, the footer buttons as icons, and the
   profile as its avatar (the rest of the chip is clipped, it still opens Harbor's account menu). */
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-brand]:has([data-harbor-sidebar-mark]) > :not([data-harbor-sidebar-mark]) { display: none; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] [data-harbor-sidebar-label] { display: none !important; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] :is(button, a):has([data-harbor-sidebar-icon]) { width: 40px; padding: 0 !important; justify-content: center; }
html:is([data-pj-nav="top"], [data-pj-nav="bottom"]) aside[data-harbor-sidebar] > [data-harbor-sidebar-footer] > :last-child:not(:only-child) {
  width: 44px; flex: none; overflow: hidden; border-radius: 999px;
}


/* ---- Fragile: Harbor sidebar internals ---------------------------------------------------- */
/* Marquee group headings. Checked against Harbor 0.9.113 chrome/sidebar.tsx: the nav scrolls in a div with
   .overflow-y-auto holding the main pages group (.flex-col), a divider ([data-tauri-drag-region].py-2.5) and the
   collections group (.flex-col). Headings only show when the sidebar has labels (240px). */
@container pj-side (min-width: 180px) {
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col:first-child::before,
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region] + .flex-col::before,
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col:first-child > [data-harbor-nav="live"]:not(:first-child)::after {
    display: block; padding: 12px 12px 6px; pointer-events: none;
    font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 14px; line-height: 16px;
    color: var(--color-ink-subtle); text-align: start;
  }
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col:first-child::before { content: "Browse"; padding-top: 2px; }
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region] + .flex-col::before { content: "Yours"; }
  /* "On air" sits above Live TV. It belongs to the button, so it is placed above it and ignores the pointer. */
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col:first-child > [data-harbor-nav="live"]:not(:first-child) { margin-top: 32px; overflow: visible; }
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col:first-child > [data-harbor-nav="live"]:not(:first-child)::after {
    content: "On air"; position: absolute; left: 0; bottom: 100%; padding-bottom: 6px;
  }
  /* the headings replace Harbor's divider line */
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region].py-2\.5 { padding: 4px 0; }
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > [data-tauri-drag-region].py-2\.5 > * { display: none; }
  html[data-pj] aside[data-harbor-sidebar] .overflow-y-auto > .flex-col { gap: 2px; }
}

/* Cinema layer (milestone 2): light spill, focus pull, title reveal, house lights, hover glow, rise-in,
   banner pointer tilt, widescreen bars, grain. Switches are html[data-pj-*] attributes set from js/30-cinema.js;
   they already account for the motion setting and Lite mode, so each rule checks one attribute.
   Only transform and opacity animate. Everything costly (the spill, the soft copy, the glow, the grain tile) is
   painted once and then only faded or moved. */

/* Light spill: two small canvases inside the banner's anchor, scaled up and crossfaded. z-index -1 puts it behind
   the page's own content (rows and their titles paint over it) while it still scrolls with the banner. */
#projector-layer-spill {
  position: absolute; z-index: -1; pointer-events: none;
  left: -14%; right: -14%; top: -30%; height: 175%;
  --pj-spill: .62;
}
html[data-pj-scheme="light"] #projector-layer-spill { --pj-spill: .34; }
#projector-layer-spill canvas {
  position: absolute; inset: 0; width: 100%; height: 100%;
  opacity: 0; transition: opacity 1.1s var(--pj-ease);
}
#projector-layer-spill canvas[data-on] { opacity: var(--pj-spill); }
html:not([data-pj-spill="on"]) #projector-layer-spill,
html[data-pj-perf="lite"] #projector-layer-spill { display: none; }

/* Focus pull: the soft copy sits just above the picture and fades out while the picture settles. */
#projector-layer-pull {
  position: absolute; pointer-events: none; object-fit: cover; filter: var(--pj-grade);
  animation: pj-unblur 1.1s var(--pj-ease) both;
}
html[data-pj-focus="on"] [data-pj-pull] > img.object-cover { animation: pj-settle 1.3s var(--pj-ease) both; }
html:not([data-pj-focus="on"]) #projector-layer-pull { display: none; }
@keyframes pj-unblur { from { opacity: .9; } to { opacity: 0; } }
@keyframes pj-settle { from { transform: scale(1.045); } }

/* Title reveal: the banner's text block rises in, title first. a/b are the same animation under two names so a new
   slide restarts it without a forced layout. Fill is "backwards" only, so when it ends Harbor's own styles (the
   logo's load fade, for one) are back in charge. */
html[data-pj-reveal="on"] [data-pj-reveal="a"] > * { animation: pj-soft-a .7s var(--pj-ease) .34s backwards; }
html[data-pj-reveal="on"] [data-pj-reveal="b"] > * { animation: pj-soft-b .7s var(--pj-ease) .34s backwards; }
html[data-pj-reveal="on"] [data-pj-reveal] > :first-child { animation-delay: .04s; }
html[data-pj-reveal="on"] [data-pj-reveal] > :nth-child(n+4) { animation-delay: .44s; }
html[data-pj-reveal="on"] [data-pj-reveal="a"] > [data-pj-title] { animation: pj-title-a .85s var(--pj-ease) .12s backwards; }
html[data-pj-reveal="on"] [data-pj-reveal="b"] > [data-pj-title] { animation: pj-title-b .85s var(--pj-ease) .12s backwards; }
@keyframes pj-soft-a { from { opacity: 0; transform: translateY(8px); } }
@keyframes pj-soft-b { from { opacity: 0; transform: translateY(8px); } }
@keyframes pj-title-a { from { opacity: 0; transform: translateY(26px); } }
@keyframes pj-title-b { from { opacity: 0; transform: translateY(26px); } }

/* House lights: a quick fade to black when Play is pressed. Removed the moment Harbor's player mounts (and hidden by
   the projector-layer rule in css/10-base.css), so it never covers the video. The dim behind the hover preview is
   under Fragile, below. */
#projector-layer-lights {
  position: fixed; inset: 0; z-index: 130; pointer-events: none;
  background: #000; opacity: 0;
}
#projector-layer-lights[data-state="black"] { animation: pj-black .45s var(--pj-ease) forwards; }
#projector-layer-lights[data-state="lift"] { animation: pj-lift .3s ease forwards; }
@keyframes pj-black { from { opacity: 0; } to { opacity: 1; } }
@keyframes pj-lift { from { opacity: 1; } to { opacity: 0; } }

/* Hover glow: a radial gradient in the poster's own color (--pj-glow, set once per poster by JS; the accent until
   then), painted once behind the poster and only faded. The lift itself is Harbor's. */
html[data-pj-glow="on"] [data-preview-anchor] { isolation: isolate; }
html[data-pj-glow="on"] [data-preview-anchor]::before {
  content: ""; position: absolute; z-index: -1; pointer-events: none;
  left: -14%; right: -14%; top: 8%; bottom: -10%;
  background: radial-gradient(closest-side, var(--pj-glow, var(--color-accent)), transparent);
  opacity: 0; transition: opacity .35s var(--pj-ease);
}
html[data-pj-glow="on"] .group:hover > [data-preview-anchor]::before,
html[data-pj-glow="on"] .group:focus-visible > [data-preview-anchor]::before { opacity: .62; }
html[data-pj-glow="on"][data-pj-scheme="light"] .group:hover > [data-preview-anchor]::before,
html[data-pj-glow="on"][data-pj-scheme="light"] .group:focus-visible > [data-preview-anchor]::before { opacity: .42; }

/* Poster light (js/30-cinema.js section 6): a blurred copy of the poster drawn once into canvas.pj-amb, placed in
   the card behind everything (the card is isolated, so z-index -1 stays inside it). Faded in on hover or keyboard
   focus and lifted with Harbor's own poster lift. When it is there, the plain radial glow above steps aside. */
html[data-pj] canvas.pj-amb { display: none; }
html[data-pj-glow="on"] button.group:has(> canvas.pj-amb) { isolation: isolate; }
html[data-pj-glow="on"] button.group:has(> canvas.pj-amb) > [data-preview-anchor]::before { display: none; }
html[data-pj-glow="on"] canvas.pj-amb {
  display: block; position: absolute; z-index: -1; pointer-events: none; border-radius: 28px;
  opacity: 0; transform: translate3d(0, 6px, 0) scale(.96);
  transition: opacity .45s var(--pj-ease), transform .45s var(--pj-ease);
}
html[data-pj-glow="on"] button.group:is(:hover, :focus-visible) > canvas.pj-amb,
html[data-pj-glow="on"] [data-tv-focused] > canvas.pj-amb { opacity: 1; transform: translate3d(0, -6px, 0) scale(1); }
html[data-pj-glow="on"][data-pj-scheme="light"] button.group:is(:hover, :focus-visible) > canvas.pj-amb { opacity: .6; }
html[data-pj-motion="off"] canvas.pj-amb { transition: none; }
/* Wide cards (continue watching, new episodes, collections): lit by script (data-on) since their hover lives on
   different elements. Inside the card it sits behind (the card is isolated); before a collection card it is a
   plain earlier sibling, so the card paints over it. Rounder corners to match the wide shape. */
html[data-pj-glow="on"] div.group:has(> canvas.pj-amb[data-wide="in"]) { isolation: isolate; }
html[data-pj-glow="on"] canvas.pj-amb[data-wide] { border-radius: 36px; }
html[data-pj-glow="on"] canvas.pj-amb[data-wide="sib"] { z-index: auto; }
html[data-pj-glow="on"] canvas.pj-amb[data-wide][data-on] { opacity: .85; transform: translate3d(0, -4px, 0) scale(1); }
html[data-pj-glow="on"][data-pj-scheme="light"] canvas.pj-amb[data-wide][data-on] { opacity: .5; }
/* The same light behind Harbor's hover preview card (first child of its frame, so the card paints over it). */
html[data-pj] canvas.pj-amb-prev { display: none; }
html[data-pj-glow="on"] canvas.pj-amb-prev {
  display: block; position: absolute; pointer-events: none; border-radius: 40px; opacity: .85;
  animation: pj-amb-in .5s var(--pj-ease) both;
}
html[data-pj-glow="on"][data-pj-scheme="light"] canvas.pj-amb-prev { opacity: .55; }
html[data-pj-motion="off"] canvas.pj-amb-prev { animation: none; }
@keyframes pj-amb-in { from { opacity: 0; transform: scale(.94); } }

/* Banner pointer tilt: JS writes inline transforms on the carousel frame, the picture and the text block (marked
   data-pj-tilt); these transitions smooth each move and ease everything back when the pointer leaves. */
html[data-pj-parallax="on"] [data-pj-tilt="frame"] { transition: transform .8s var(--pj-ease); }
html[data-pj-parallax="on"] [data-pj-tilt="copy"] { transition: transform .7s var(--pj-ease); }
html[data-pj-parallax="on"] img[data-pj-tilt="art"] { transition: opacity .5s ease, transform .7s var(--pj-ease); }

/* Widescreen bars: black halves that open on each slide. The 2.39:1 crop is under Fragile. */
#projector-layer-bars { position: absolute; inset: 0; z-index: 25; pointer-events: none; display: none; }
html[data-pj-wide="on"] #projector-layer-bars { display: block; }
#projector-layer-bars i { position: absolute; left: 0; right: 0; height: 50.5%; background: #000; transform: scaleY(0); }
#projector-layer-bars i:first-child { top: 0; transform-origin: top; }
#projector-layer-bars i:last-child { bottom: 0; transform-origin: bottom; }
html[data-pj-motion="on"] #projector-layer-bars[data-run="a"] i { animation: pj-bars-a .9s var(--pj-ease) both; }
html[data-pj-motion="on"] #projector-layer-bars[data-run="b"] i { animation: pj-bars-b .9s var(--pj-ease) both; }
@keyframes pj-bars-a { from { transform: scaleY(1); } to { transform: scaleY(0); } }
@keyframes pj-bars-b { from { transform: scaleY(1); } to { transform: scaleY(0); } }

/* Grain: one noise tile, jumped about 10 times a second. Under Harbor's hover preview (z 110) and window controls. */
#projector-layer-grain {
  position: fixed; inset: -25%; z-index: 100; pointer-events: none;
  opacity: .06; background-repeat: repeat;
  animation: pj-grain 1s steps(10) infinite;
}
html[data-pj-scheme="light"] #projector-layer-grain { opacity: .045; }
html[data-pj-motion="off"] #projector-layer-grain { animation: none !important; }
@keyframes pj-grain {
  0% { transform: translate(0, 0); } 10% { transform: translate(-5%, -8%); } 20% { transform: translate(-12%, 4%); }
  30% { transform: translate(6%, -12%); } 40% { transform: translate(-4%, 12%); } 50% { transform: translate(-12%, 8%); }
  60% { transform: translate(12%, 0); } 70% { transform: translate(0, 12%); } 80% { transform: translate(3%, 11%); } 90% { transform: translate(-8%, 6%); }
}

/* ---- Fragile: cinema layer. Checked against Harbor 0.9.113 ------------------------------------------------- */

/* Rise-in on scroll. CSS scroll-driven animations; engines without them skip the block and just show the content
   (JS also leaves data-pj-rise off there). Each row (components/row.tsx: the [class~="group/row"] wrapper) drives
   its own cards so the stagger works inside a horizontal rail, whose own scroller can't. Animates opacity and the
   translate property, so Harbor's hover lift (a transform on the poster inside the card) is untouched. Row titles
   (h3.truncate.font-medium.tracking-tight, as in css/60-pages.css) follow their own position. */
@supports (animation-timeline: view()) {
  html[data-pj-rise="on"] [class~="group/row"] { view-timeline: --pj-row block; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > * {
    animation: pj-rise linear both;
    animation-timeline: --pj-row;
    animation-range: entry calc(var(--pj-i, 0) * 4%) entry calc(70% + var(--pj-i, 0) * 4%);
  }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(2) { --pj-i: 1; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(3) { --pj-i: 2; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(4) { --pj-i: 3; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(5) { --pj-i: 4; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(6) { --pj-i: 5; }
  html[data-pj-rise="on"] [class~="group/row"] .grid-flow-col > :nth-child(n+7) { --pj-i: 6; }
  html[data-pj-rise="on"] main h3.truncate.font-medium.tracking-tight {
    animation: pj-rise linear both;
    animation-timeline: view(block);
    animation-range: entry 0% entry 70%;
  }
}
@keyframes pj-rise { from { opacity: 0; translate: 0 28px; } }

/* House lights behind the hover preview. components/hover-preview.tsx renders one full-screen layer,
   div.pointer-events-none.fixed.inset-0.z-[110], with the card inside. Its ::before dims the page under the card,
   so the dim exists exactly as long as the preview does. While the preview leaves, its frame gets
   .pointer-events-none and the dim fades out with it. */
html[data-pj-lights="on"] div.pointer-events-none.fixed.inset-0.z-\[110\]::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: #000; opacity: .42;
  animation: pj-dim .4s var(--pj-ease) backwards;
  transition: opacity .22s ease;
}
html[data-pj-lights="on"][data-pj-scheme="light"] div.pointer-events-none.fixed.inset-0.z-\[110\]::before { background: #1b1813; opacity: .2; }
html[data-pj-lights="on"] div.pointer-events-none.fixed.inset-0.z-\[110\]:has(> .pointer-events-none)::before { opacity: 0; }
@keyframes pj-dim { from { opacity: 0; } }

/* Harbor's hover ring (index.css: button.group:hover .harbor-card-ring::after, accent at 60%) takes the poster's
   glow color, so ring and glow read as one light. */
html[data-pj-glow="on"] button.group:not([data-no-card-ring]):hover .harbor-card-ring::after {
  box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--pj-glow, var(--color-accent)) 72%, transparent);
}

/* Widescreen crop. hero-carousel.tsx: each slide is [aria-hidden].w-full.shrink-0 holding the Hero <section>
   (h-[560px], or h-[78vh] when full) or a placeholder of the same height; both take the 2.39:1 ratio. */
html[data-pj-wide="on"] [data-scroll-anchor="hero"] [aria-hidden].w-full.shrink-0 > * {
  height: auto !important; min-height: 420px !important; aspect-ratio: 2.39 / 1;
}

/* Hover grace for every pointer-driven light. Lights come up at once, but going out waits a beat, so the pointer
   skimming an edge (or Harbor's lift shifting the card under it) never flashes them. Fading stays transform/opacity. */
html[data-pj] [data-preview-anchor]::before,
html[data-pj] [data-preview-anchor]::after,
html[data-pj] [data-preview-anchor] .harbor-poster::before,
html[data-pj] canvas.pj-amb,
html[data-pj] .harbor-service-tile::before { transition-delay: .14s !important; }
html[data-pj] .group:is(:hover, :focus-visible) > [data-preview-anchor]::before,
html[data-pj] .group:is(:hover, :focus-visible) [data-preview-anchor]::after,
html[data-pj] .group:is(:hover, :focus-visible) [data-preview-anchor] .harbor-poster::before,
html[data-pj] button.group:is(:hover, :focus-visible) > canvas.pj-amb,
html[data-pj] canvas.pj-amb[data-on],
html[data-pj] .harbor-service-tile:is(:hover, :focus-visible)::before { transition-delay: 0s !important; }
html[data-pj-motion="off"] :is(canvas.pj-amb, [data-preview-anchor]) { transition-delay: 0s !important; }

/* 9. Harbor features: milestone 3 ---------------------------------------- */
/* Modals and search: solid, no blur (Harbor blurs behind search; at 93% opacity the blur was barely visible and
   still cost a full-screen filter). */
html[data-pj] .modal-panel {
  background-color: var(--color-elevated) !important;
  border-color: var(--color-edge-soft) !important;
  border-radius: var(--pj-r-md) !important;
  box-shadow: 0 40px 90px -30px rgb(0 0 0 / .75) !important;
}
html[data-pj] .harbor-search-backdrop {
  background: color-mix(in srgb, var(--color-canvas) 94%, transparent) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}
html[data-pj] ::selection { background: color-mix(in srgb, var(--color-accent) 38%, transparent); }

/* Search: a marquee-style input in the display face with an accent caret. */
html[data-pj] .harbor-search-backdrop ~ div .modal-panel input { caret-color: var(--color-accent); font-family: var(--font-display); font-weight: var(--pj-d-weight, 500); letter-spacing: -.01em; }
html[data-pj] .harbor-search-backdrop ~ div .modal-panel > .border-b { border-color: var(--color-edge-soft) !important; }

/* Keyboard and gamepad focus (lib/keyboard-navigation.ts marks data-tv-focused and html[data-input-modality]).
   A strong accent ring with a soft accent bloom. On poster cards the ring moves onto the poster so it hugs the art. */
html[data-pj] { --tv-focus-ring: var(--color-accent); }
html[data-pj]:not([data-input-modality="pointer"]) [data-tv-focused="true"] {
  box-shadow: 0 0 0 2px var(--color-canvas), 0 0 0 4px var(--color-accent), 0 0 18px 2px color-mix(in srgb, var(--color-accent) 45%, transparent) !important;
}
html[data-pj]:not([data-input-modality="pointer"]) [data-tv-focused="true"]:is(:has(> [data-preview-anchor]), :has(> .harbor-poster)),
html[data-pj] :is(button, a, [tabindex]):focus-visible:is(:has(> [data-preview-anchor]), :has(> .harbor-poster)) {
  box-shadow: none !important; outline: none !important;
}
html[data-pj]:not([data-input-modality="pointer"]) [data-tv-focused="true"] > :is([data-preview-anchor] > .harbor-poster, .harbor-poster),
html[data-pj]:not([data-input-modality="pointer"]) [data-tv-focused="true"] > [data-preview-anchor] > .harbor-poster,
html[data-pj] :is(button, a, [tabindex]):focus-visible > .harbor-poster,
html[data-pj] :is(button, a, [tabindex]):focus-visible > [data-preview-anchor] > .harbor-poster {
  outline: 3px solid var(--color-accent) !important; outline-offset: 3px;
  box-shadow: 0 0 22px 2px color-mix(in srgb, var(--color-accent) 40%, transparent) !important;
}
html[data-pj] :is(button, a, select, summary, [tabindex]):focus-visible { outline-color: var(--color-accent) !important; }

/* Back to top (components/back-to-top.tsx) and the add-on page's ScrollTopButton: solid, no blur. */
html[data-pj] button.fixed.bottom-5.end-5.z-40.rounded-md,
html[data-pj] button.fixed.bottom-6.end-6.rounded-full {
  width: 40px; height: 40px; border-radius: var(--pj-r-sm) !important;
  background: var(--color-elevated) !important; border: 1px solid var(--color-edge-soft) !important; color: var(--color-ink-muted) !important;
  box-shadow: 0 10px 24px -12px rgb(0 0 0 / .6); -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
}
html[data-pj] button.fixed.bottom-5.end-5.z-40.rounded-md:hover,
html[data-pj] button.fixed.bottom-6.end-6.rounded-full:hover { color: var(--color-accent) !important; border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-edge-soft)) !important; }

/* ======================================================================================================
   Fragile (Harbor 0.9.113)
   These target Tailwind class combinations and inline styles in Harbor's components, because Harbor gives
   these pieces no data attributes. Check them after every Harbor update.
   ====================================================================================================== */

/* Badges on cards (poster.tsx Badge, DUB, CinemaBadge, RerunBadge, ScoreStack, RankBadge, ContinueCard pills,
   episode number and rating). One small shape: 4px corners, solid canvas, hairline, no blur. */
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) :is(span, div).absolute.rounded-md,
html[data-pj] span[role="button"].absolute.start-2.top-2.rounded-md {
  min-height: 18px; display: inline-flex; align-items: center; gap: 4px; padding: 1px 6px !important; box-sizing: border-box;
  border-radius: 4px !important; border: 1px solid var(--color-edge-soft) !important; box-shadow: none !important;
  background: color-mix(in srgb, var(--color-canvas) 92%, transparent) !important; color: var(--color-ink-muted) !important;
  -webkit-backdrop-filter: none !important; backdrop-filter: none !important; filter: none !important;
}
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) :is(span, div).absolute.rounded-md.uppercase,
html[data-pj] span[role="button"].absolute.start-2.top-2.rounded-md { font-size: 10px !important; font-weight: 600 !important; letter-spacing: .06em !important; }
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) :is(span, div).absolute.rounded-md :is(.text-ink, .font-semibold) { color: var(--color-ink) !important; }
/* Accent variant (accent Badge, DUB, ContinueCard "+N" new episodes): solid stock color. */
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) .absolute.rounded-md.bg-accent\/90,
html[data-pj] .harbor-poster span.rounded-full.bg-accent\/90 {
  background: var(--color-accent) !important; color: var(--pj-on-accent) !important; border-color: transparent !important;
}
html[data-pj] .harbor-poster span.rounded-full.bg-accent\/90 {
  height: 18px !important; padding: 0 6px !important; border-radius: 4px !important; font-size: 10px !important; font-weight: 700 !important; letter-spacing: .06em !important;
}
/* Round markers (watchlist and watched dots): smaller, solid, watched in the stock color. */
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) span.absolute.h-6.w-6.rounded-full {
  width: 20px !important; height: 20px !important; background: color-mix(in srgb, var(--color-canvas) 92%, transparent) !important;
  color: var(--color-ink) !important; box-shadow: 0 0 0 1px var(--color-edge-soft) !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
}
html[data-pj] :is([data-preview-anchor], .harbor-poster, [data-ep]) span.absolute.h-6.w-6.rounded-full:is(.bg-emerald-500\/90, .bg-emerald-400\/22) {
  background: var(--color-accent) !important; color: var(--pj-on-accent) !important; box-shadow: none !important;
}
/* Episode title badges (views/detail/badges.tsx): New is solid stock color with no shimmer loop; Upcoming is quiet. */
html[data-pj] h4 > .rounded-\[5px\] { border-radius: 4px !important; padding: 1px 5px !important; letter-spacing: .08em !important; }
html[data-pj] h4 > .rounded-\[5px\].border-accent\/30 { background: var(--color-accent) !important; color: var(--pj-on-accent) !important; border-color: transparent !important; }
html[data-pj] h4 > .rounded-\[5px\] .animate-shimmer { display: none !important; }

/* Continue watching (ContinueCard): tighter corners, lighter vignette, a thin accent line for progress. */
html[data-pj] .harbor-poster.aspect-\[16\/9\] { border-radius: var(--pj-r-sm) !important; }
html[data-pj] .harbor-poster.aspect-\[16\/9\] > [class*="shadow-[inset_0_0_100px"] { box-shadow: inset 0 0 60px rgb(0 0 0 / .28) !important; }
html[data-pj] :is(.harbor-poster, [data-ep] .rounded-lg) > .absolute.inset-x-0.bottom-0.h-\[3px\] {
  height: 2px !important; background: color-mix(in srgb, var(--color-ink) 22%, transparent) !important;
}
html[data-pj] :is(.harbor-poster, [data-ep] .rounded-lg) > .absolute.inset-x-0.bottom-0.h-\[3px\] > .bg-accent { box-shadow: 0 0 8px color-mix(in srgb, var(--color-accent) 60%, transparent); }

/* Top 10 (top-rank-card.tsx): the outlined Oswald numeral becomes a solid serif numeral in its own column left of
   the poster (the poster covers the right 60%), so no digit hides behind the art. */
html[data-pj] { --font-rank: var(--font-display); }
html[data-pj] :is(button[data-no-card-ring][style*="228 / 246"], [data-scroll-anchor="top10"] button[data-no-card-ring]) > span[aria-hidden="true"] {
  inset-inline-start: 0 !important; width: 40%; height: 90cqw !important; box-sizing: border-box; padding-inline-end: 3cqw;
  justify-content: flex-end; align-items: flex-end !important;
  font-family: var(--font-display) !important; font-weight: var(--pj-d-weight, 500) !important; font-size: 64cqw !important;
  line-height: .78 !important; letter-spacing: -.05em !important; font-variant-numeric: lining-nums;
  color: color-mix(in srgb, var(--color-ink) 32%, transparent) !important;
  -webkit-text-stroke: 0 !important; -webkit-mask-image: none !important; mask-image: none !important;
}
html[data-pj] :is(button[data-no-card-ring][style*="228 / 246"], [data-scroll-anchor="top10"] button[data-no-card-ring]) > span[aria-hidden="true"]:has(> span) { font-size: 36cqw !important; letter-spacing: -.06em !important; }
html[data-pj] :is(button[data-no-card-ring][style*="228 / 246"], [data-scroll-anchor="top10"] button[data-no-card-ring]) > span[aria-hidden="true"] > span {
  -webkit-text-stroke: 0 !important; color: inherit !important; margin-inline-start: 0 !important;
}

/* Spoilers (lib/spoilers.ts THUMB and TEXT). Harbor blurs live with a 14px filter on every hidden episode; Projector
   uses a static frosted cover instead (no filter cost) that lifts on hover or keyboard focus of the row. */
html[data-pj] .blur-\[14px\] { filter: none !important; scale: none !important; transform: none !important; position: relative; }
html[data-pj] .blur-\[14px\]::after {
  content: "No spoilers"; position: absolute; inset: 0; z-index: 1; display: grid; place-items: center;
  font: 600 10px/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--color-ink-muted);
  background:
    repeating-linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 5%, transparent) 0 1px, transparent 1px 6px),
    color-mix(in srgb, var(--color-surface) 94%, transparent);
  border-radius: inherit; opacity: 1; transition: opacity 180ms var(--pj-ease, ease);
}
html[data-pj] .group:is(:hover, :focus-within) .blur-\[14px\]::after { opacity: 0; }
html[data-pj] .blur-\[5px\].select-none {
  filter: none !important; transition: none !important;
  color: transparent !important; text-shadow: 0 0 7px color-mix(in srgb, var(--color-ink) 70%, transparent);
}
html[data-pj] .group:is(:hover, :focus-within) .blur-\[5px\].select-none { color: inherit !important; text-shadow: none; }

/* Hover preview (components/hover-preview.tsx, crown.tsx, block.tsx, marquee.tsx). Root: the fixed z-[110] layer.
   A credits card: serif title, small tracked credits line, a static glow in the stock color. The house lights
   dimming behind it belongs to the cinema module. */
html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"] {
  border-radius: var(--pj-r-md) !important; background: var(--color-elevated) !important;
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--pj-glow, var(--color-accent)) 26%, var(--color-edge-soft)),
    0 30px 70px -28px rgb(0 0 0 / .85), 0 0 64px -14px color-mix(in srgb, var(--pj-glow, var(--color-accent)) 55%, transparent) !important;
}
/* Open tilt: the card swings in from a slight lean and settles flat once, like a screen dropping into place.
   Uses the separate rotate/translate properties so Harbor's own transform on the card is left alone. */
html[data-pj]:not([data-pj-motion="off"]) .fixed.inset-0.z-\[110\] [role="presentation"] {
  transform-origin: 50% 0; animation: pj-card-swing .34s cubic-bezier(.2, .8, .2, 1) both;
}
html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"][data-pj-grown] { animation: none; }
@keyframes pj-card-swing { from { rotate: x 9deg; translate: 0 6px; } to { rotate: x 0deg; translate: 0 0; } }
@media (prefers-reduced-motion: reduce) { html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"] { animation: none; } }
/* A thin line of light along the top edge, like the projector catching the card, in the poster's color. */
html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"]::after {
  content: ""; position: absolute; left: 12%; right: 12%; top: 0; height: 1px; z-index: 5; pointer-events: none;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--pj-glow, var(--color-accent)) 50%, #fff), transparent);
}
/* Title-card rule above the title, the same mark as page headings. */
html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"] h3::before {
  content: ""; display: block; width: 28px; height: 2px; margin-bottom: 10px; border-radius: 1px;
  background: linear-gradient(90deg, var(--pj-glow, var(--color-accent)), transparent);
}
html[data-pj] .fixed.inset-0.z-\[110\] [role="presentation"] h3 {
  font-family: var(--font-display) !important; font-weight: var(--pj-d-weight, 500) !important;
  font-size: 25px !important; line-height: 1.08 !important; letter-spacing: -.015em !important; color: var(--color-ink) !important;
}
html[data-pj] .fixed.inset-0.z-\[110\] .h-\[52\%\],
html[data-pj] .fixed.inset-0.z-\[110\] .relative.w-full.overflow-hidden > .pointer-events-none.absolute.inset-0 {
  background: linear-gradient(to top, var(--color-elevated) 0%, color-mix(in srgb, var(--color-elevated) 55%, transparent) 45%, transparent 100%) !important;
}
html[data-pj] .fixed.inset-0.z-\[110\] span.absolute.start-3.top-3 {
  border-radius: 4px !important; border-color: transparent !important; background: var(--color-accent) !important; color: var(--pj-on-accent) !important;
  -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
}
html[data-pj] .fixed.inset-0.z-\[110\] [data-stagger="1"].truncate.tabular-nums {
  font-size: 11px !important; font-weight: 600 !important; letter-spacing: .12em !important; text-transform: uppercase;
  padding-block: 6px; border-block: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
}
html[data-pj] .fixed.inset-0.z-\[110\] [data-stagger="2"].justify-between > span { color: var(--color-accent) !important; }
html[data-pj] .fixed.inset-0.z-\[110\] .absolute.inset-x-0.bottom-0.h-\[3px\] { height: 2px !important; }
html[data-pj] .fixed.inset-0.z-\[110\] button.h-11.w-11.rounded-full.bg-ink { background: var(--color-accent) !important; color: var(--pj-on-accent) !important; }

/* Screensaver (components/screensaver/ambient-overlay.tsx) as "Intermission": the title large in the display serif,
   a slow even crossfade, the clock small at the top end. Harbor's own timers, slides and dismiss stay as they are. */
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > img { transition: opacity 2000ms ease-in-out, transform 16000ms linear !important; }
html[data-pj][data-pj-motion="off"] .fixed.inset-0.z-\[200\].cursor-none > img { transform: none !important; transition: opacity 2000ms ease-in-out !important; }
@media (prefers-reduced-motion: reduce) { html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > img { transform: none !important; } }
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bg-gradient-to-t {
  background: linear-gradient(90deg, rgb(0 0 0 / .84) 0%, rgb(0 0 0 / .5) 42%, rgb(0 0 0 / .12) 72%, rgb(0 0 0 / .3) 100%) !important;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .absolute.inset-0[style*="radial-gradient"] {
  background: radial-gradient(120% 90% at 30% 30%, color-mix(in srgb, var(--color-accent) 12%, #0b0a09), #050505 70%) !important;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .top-0 svg { display: none; }
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .top-0 span.font-display { font-size: 0 !important; }
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .top-0 span.font-display::after {
  content: "Intermission"; font-size: 22px; font-style: italic; font-weight: 400; letter-spacing: .01em; color: rgb(255 255 255 / .8);
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end { top: 0; }
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .flex-col:first-child {
  position: absolute; top: 40px; inset-inline-end: 48px; align-items: flex-end;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .flex-col:first-child > :first-child { font-size: 12px !important; letter-spacing: .2em !important; }
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .flex-col:first-child > :last-child {
  font-family: var(--font-display); font-size: 44px !important; font-weight: 400 !important; margin-top: 6px;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .max-w-\[46\%\] {
  max-width: min(70%, 1100px) !important; align-items: flex-start !important; text-align: start !important; margin: 0 !important;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .max-w-\[46\%\] > :first-child:not(:last-child) {
  color: color-mix(in oklab, var(--color-accent) 55%, #fff) !important; font-size: 12px !important; letter-spacing: .24em !important;
}
html[data-pj] .fixed.inset-0.z-\[200\].cursor-none > .bottom-0.items-end > .max-w-\[46\%\] > :last-child {
  font-family: var(--font-display); font-weight: var(--pj-d-weight, 500) !important; font-size: clamp(56px, 8vw, 128px) !important;
  line-height: .95 !important; letter-spacing: -.025em !important; margin-top: 12px !important;
  white-space: normal !important; display: -webkit-box !important; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}

/* Your Streaming tiles (harbor-service-tile). Harbor tints every logo through --service-logo-filter, white by default,
   which vanishes on light tiles. In the light scheme the logos print in near-black ink instead. */
html[data-pj][data-pj-scheme="light"] { --service-logo-filter: brightness(0) opacity(.82); }
html[data-pj][data-pj-scheme="light"] .harbor-service-tile { background: color-mix(in srgb, var(--color-raised) 70%, transparent) !important; }
html[data-pj][data-pj-scheme="light"] .harbor-service-tile:hover { background: var(--color-raised) !important; }

/* Streaming tile glow: pointing at a Your Streaming tile lights it from behind in the service's own color.
   One radial light per tile, drawn once and only faded and scaled. Unknown services use the accent. */
html[data-pj] .harbor-service-tile { position: relative; isolation: isolate; overflow: hidden; }
html[data-pj][data-pj-brand="on"] .harbor-service-tile::before {
  content: ""; position: absolute; inset: -20%; z-index: -1; pointer-events: none; opacity: 0; transform: scale(.7);
  background: radial-gradient(closest-side, color-mix(in srgb, var(--pj-brand, var(--color-accent)) 70%, transparent), transparent);
  transition: opacity .35s ease, transform .5s var(--pj-ease);
}
html[data-pj][data-pj-brand="on"] .harbor-service-tile:is(:hover, :focus-visible)::before { opacity: .55; transform: scale(1); }
html[data-pj][data-pj-brand="on"][data-pj-scheme="light"] .harbor-service-tile:is(:hover, :focus-visible)::before { opacity: .4; }
.harbor-service-tile:has(img[alt="Netflix"]) { --pj-brand: #e50914; }
.harbor-service-tile:has(img[alt="Disney+"]) { --pj-brand: #1f4fe0; }
.harbor-service-tile:has(img[alt="Hulu"]) { --pj-brand: #1ce783; }
.harbor-service-tile:has(img[alt="Prime Video"]) { --pj-brand: #00a8e1; }
.harbor-service-tile:has(img[alt="Apple TV+"]) { --pj-brand: #b8bec4; }
.harbor-service-tile:has(img[alt="Max"]) { --pj-brand: #2a4dff; }
.harbor-service-tile:has(img[alt="Paramount+"]) { --pj-brand: #0064ff; }
.harbor-service-tile:has(img[alt="Peacock"]) { --pj-brand: #f5b700; }
.harbor-service-tile:has(img[alt="Crunchyroll"]) { --pj-brand: #f47521; }
.harbor-service-tile:has(img[alt="AMC+"]) { --pj-brand: #c9c9c9; }
.harbor-service-tile:has(img[alt="STARZ"]) { --pj-brand: #9aa0a6; }
.harbor-service-tile:has(img[alt="Shudder"]) { --pj-brand: #e3001b; }
.harbor-service-tile:has(img[alt="CuriosityStream"]) { --pj-brand: #f7a600; }

/* Marquee bulbs: Continue Watching progress becomes a row of bulbs, unlit along the track and lit up to where you
   stopped. Static dots with one glow, no animation. */
html[data-pj][data-pj-bulbs="on"] [data-continue-card-trigger] .absolute.inset-x-0.bottom-0.h-\[3px\] {
  height: 7px !important; bottom: 4px !important; inset-inline: 10px !important; background-color: transparent !important;
  background-image: radial-gradient(circle at 3.5px 3.5px, color-mix(in srgb, #fff 26%, transparent) 1.6px, transparent 2.3px) !important;
  background-size: 10px 7px !important;
}
html[data-pj][data-pj-bulbs="on"] [data-continue-card-trigger] .absolute.inset-x-0.bottom-0.h-\[3px\] > .h-full.bg-accent {
  background-color: transparent !important;
  background-image: radial-gradient(circle at 3.5px 3.5px, #fff6dc 1.4px, color-mix(in srgb, var(--color-accent) 90%, #ffb347) 2.4px, transparent 3.2px) !important;
  background-size: 10px 7px !important; filter: drop-shadow(0 0 3px color-mix(in srgb, var(--color-accent) 80%, #ffb347));
}

/* 5. Tools: Customize button, command palette, shortcut sheet, settings panel, first-run card, toast ----------
   Built by js/50-tools.js. Solid surfaces in Harbor's color tokens, no blur. Only opacity and transform animate, and
   html[data-pj-motion="off"] (css/10-base.css) cuts every duration. Text uses ink, ink-muted or ink-subtle, which
   js/00-core.js keeps at 4.5:1 or more on all four surfaces. Nothing sits on an accent fill as text. */
:is(#projector-palette, #projector-keys, #projector-panel, #projector-toast, #projector-customize) {
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}
:is(#projector-palette, #projector-keys, #projector-panel) :where(*, *::before, *::after) { box-sizing: border-box; }
:where(#projector-palette, #projector-keys, #projector-panel, #projector-customize) :where(button, input) {
  font: inherit; color: inherit; margin: 0;
}
:where(#projector-palette, #projector-keys, #projector-panel) :where(button) {
  background: none; border: 0; padding: 0; cursor: pointer; text-align: inherit;
}
:where(#projector-palette, #projector-keys, #projector-panel) :where(h2, p, dl, dd) { margin: 0; }
:is(#projector-palette, #projector-keys, #projector-panel, #projector-customize) kbd {
  display: inline-block; min-width: 20px; padding: 0 5px; border-radius: 4px; border: 1px solid var(--color-edge);
  font: 600 11px/16px var(--font-sans); color: var(--color-ink-muted); text-align: center; white-space: nowrap;
  background: color-mix(in srgb, var(--color-canvas) 50%, transparent);
}
:is(#projector-palette, #projector-keys, #projector-panel, #projector-customize) :focus-visible {
  outline: 2px solid var(--color-accent); outline-offset: 2px;
}
:is(#projector-palette, #projector-keys, #projector-panel, #projector-toast)[hidden],
:is(#projector-palette, #projector-panel) [hidden] { display: none !important; }

/* Harbor hides its chrome for the player, the play picker and Settings. Projector's layers go with it (the panel is
   also closed by js/50-tools.js), so nothing can cover the native video layer on Windows. */
html[data-chrome-hidden] :is(#projector-palette, #projector-keys, #projector-panel, #projector-toast, #projector-customize),
html:has([data-harbor-player]) :is(#projector-palette, #projector-keys, #projector-panel, #projector-toast, #projector-welcome) { display: none !important; }

/* ---------- Customize, in Harbor's sidebar footer ----------
   The 72px icon column shows only the icon; from 180px (Harbor's 240px sidebar) the label and key hint show too.
   pj-side is the container css/20-nav.css puts on the sidebar. */
#projector-customize {
  /* Matches Harbor's own Collapse button right above it (chrome/sidebar/collapse-toggle.tsx: h-9, rounded-lg,
     text-ink-subtle, 13px, hover bg-elevated/60 and text-ink-muted), so it reads as part of Harbor's footer. */
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 36px; height: 36px; margin: 0 auto 4px; padding: 0; border: 0; border-radius: 8px;
  background: transparent; color: var(--color-ink-subtle); font-size: 13px; font-weight: 500; line-height: 20px; cursor: pointer;
  position: relative; isolation: isolate;
}
/* The hover fill is drawn once and faded with opacity (only transform and opacity animate); the text color swaps at once. */
#projector-customize::before {
  content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
  background: color-mix(in srgb, var(--color-elevated) 60%, transparent); opacity: 0; transition: opacity .15s ease;
}
#projector-customize:hover, #projector-customize[aria-expanded="true"] { color: var(--color-ink-muted); }
#projector-customize:is(:hover, [aria-expanded="true"])::before { opacity: 1; }
#projector-customize svg { flex: none; }
#projector-customize[aria-expanded="true"] svg { color: var(--color-accent); }
#projector-customize .pjt-cust-label, #projector-customize kbd { display: none; }
@container pj-side (min-width: 180px) {
  #projector-customize { width: 100%; justify-content: flex-start; padding: 0 12px; margin: 0 0 4px; }
  #projector-customize .pjt-cust-label { display: inline; }
  #projector-customize kbd { display: inline-block; margin-left: auto; }
}

/* ---------- shared pieces ---------- */
.pjt-x {
  display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--pj-r-sm, 8px); color: var(--color-ink-muted);
}
.pjt-x:hover { color: var(--color-ink); background: var(--color-raised); }
.pjt-hint { font-size: 12px; line-height: 17px; color: var(--color-ink-muted); }
.pjt-btns { display: flex; flex-wrap: wrap; gap: 8px; }
.pjt-btn {
  min-height: 34px; padding: 0 14px; border-radius: var(--pj-r-sm, 8px); font-size: 13px; font-weight: 600; line-height: 18px;
  background: var(--color-raised); color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-edge);
}
.pjt-btn:hover { background: color-mix(in srgb, var(--color-ink) 12%, var(--color-raised)); }
/* Primary is ink on canvas colors, never text on the accent, so it reads in every stock and with any artwork. */
.pjt-btn.pjt-primary { background: var(--color-ink); color: var(--color-canvas); box-shadow: none; }
.pjt-btn.pjt-primary:hover { background: color-mix(in srgb, var(--color-ink) 86%, var(--color-canvas)); }
.pjt-btn.pjt-danger { color: var(--color-danger); }
.pjt-link { font-weight: 600; text-decoration: underline; text-underline-offset: 3px; color: var(--color-ink); }

/* ---------- palette and shortcut sheet ---------- */
.pjt-scrim {
  position: fixed; inset: 0; z-index: 2100; display: flex; justify-content: center; align-items: flex-start;
  padding: 14vh 16px 16px; background: rgb(0 0 0 / .55);
  animation: pj-tools-fade .16s ease both;
}
.pjt-pal, .pjt-sheet {
  width: min(580px, 100%); max-height: 100%; display: flex; flex-direction: column;
  background: var(--color-elevated); color: var(--color-ink); border: 1px solid var(--color-edge); border-radius: var(--pj-r-md, 12px);
  box-shadow: 0 40px 80px -30px rgb(0 0 0 / .8); overflow: hidden;
  animation: pj-tools-pop .2s var(--pj-ease, ease) both;
}
@keyframes pj-tools-fade { from { opacity: 0; } }
@keyframes pj-tools-pop { from { opacity: 0; transform: translateY(-8px) scale(.985); } }
.pjt-pal-input {
  flex: none; width: 100%; height: 54px; padding: 0 18px; border: 0; border-bottom: 1px solid var(--color-edge);
  background: transparent; color: var(--color-ink); font-size: 16px; outline: none;
}
.pjt-pal-input::placeholder { color: var(--color-ink-subtle); opacity: 1; }
#projector-palette .pjt-pal-input:focus-visible { outline: none; }
.pjt-pal-list { margin: 0; padding: 6px; max-height: min(52vh, 420px); overflow-y: auto; overscroll-behavior: contain; }
.pjt-pal-group { padding: 10px 12px 4px; font-size: 12px; line-height: 16px; font-weight: 600; color: var(--color-ink-subtle); }
.pjt-pal-item {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 38px; padding: 0 12px;
  border-radius: var(--pj-r-sm, 8px); font-size: 14px; color: var(--color-ink); cursor: pointer;
}
.pjt-pal-item[aria-selected="true"] { background: var(--color-raised); box-shadow: inset 2px 0 0 var(--color-accent); }
.pjt-pal-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pjt-pal-state { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-ink-muted); white-space: nowrap; }
.pjt-pal-state.pjt-on::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }
.pjt-pal-empty { padding: 18px; font-size: 14px; color: var(--color-ink-muted); }
.pjt-pal-foot {
  flex: none; display: flex; flex-wrap: wrap; gap: 16px; padding: 10px 16px; border-top: 1px solid var(--color-edge);
  font-size: 12px; line-height: 16px; color: var(--color-ink-muted);
}
.pjt-sheet { padding: 18px 20px 20px; gap: 16px; }
.pjt-sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: -4px -8px 0 0; }
.pjt-sheet h2 { font-size: 17px; line-height: 24px; font-weight: 650; }
.pjt-keylist { display: grid; grid-template-columns: auto 1fr; gap: 10px 18px; align-items: center; font-size: 14px; line-height: 20px; }
.pjt-keylist dt { display: flex; flex-wrap: wrap; gap: 4px; }
.pjt-keylist dd { color: var(--color-ink-muted); }

/* ---------- settings panel ---------- */
#projector-panel {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 2050; width: min(420px, 100vw);
  display: flex; flex-direction: column;
  background: var(--color-surface); color: var(--color-ink); border-left: 1px solid var(--color-edge);
  box-shadow: -30px 0 60px -30px rgb(0 0 0 / .6);
  transform: translateX(100%); transition: transform .28s var(--pj-ease, ease);
  font-size: 14px; line-height: 20px;
}
#projector-panel.pjt-open { transform: none; }
.pjt-ph { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 16px 12px 12px 18px; }
.pjt-ph h2 {
  font-family: var(--font-display); font-weight: var(--pj-d-weight, 600); font-stretch: var(--pj-d-stretch, 100%);
  letter-spacing: var(--pj-d-track, 0); font-size: 28px; line-height: 32px;
}
.pjt-tabs { flex: none; display: flex; gap: 2px; margin: 0 16px; padding: 3px; border-radius: var(--pj-r-sm, 8px); background: var(--color-raised); }
.pjt-tabs button {
  flex: 1 1 auto; min-height: 30px; padding: 0 8px; border-radius: 6px; font-size: 13px; font-weight: 600; line-height: 16px;
  color: var(--color-ink-muted); white-space: nowrap;
}
.pjt-tabs button:hover { color: var(--color-ink); }
.pjt-tabs button[aria-selected="true"] { background: var(--color-canvas); color: var(--color-ink); box-shadow: 0 1px 2px rgb(0 0 0 / .18); }
.pjt-pbody { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 4px 18px 24px; display: flex; flex-direction: column; gap: 10px; }
.pjt-pfoot {
  flex: none; display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 10px 18px 12px; border-top: 1px solid var(--color-edge-soft);
  font-size: 12px; line-height: 16px; color: var(--color-ink-muted);
}
.pjt-field { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; min-width: 0; }
.pjt-label { font-size: 13px; line-height: 18px; font-weight: 650; color: var(--color-ink); }
.pjt-seg { display: flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: var(--pj-r-sm, 8px); background: var(--color-raised); }
.pjt-seg button { flex: 1 1 auto; min-height: 30px; padding: 0 10px; border-radius: 6px; font-size: 13px; color: var(--color-ink-muted); text-align: center; }
.pjt-seg button:hover { color: var(--color-ink); }
.pjt-seg button[aria-checked="true"] { background: var(--color-canvas); color: var(--color-ink); font-weight: 600; box-shadow: 0 1px 2px rgb(0 0 0 / .18); }
.pjt-timeset { display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: var(--pj-r-sm, 8px); border: 1px solid var(--color-edge-soft); }
.pjt-range { display: grid; grid-template-columns: 1fr auto; gap: 6px; font-size: 13px; color: var(--color-ink); }
.pjt-range output { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--color-ink-muted); }
.pjt-range input { grid-column: 1 / -1; width: 100%; margin: 0; accent-color: var(--color-accent); }
.pjt-cards { display: grid; gap: 8px; }
.pjt-card {
  display: grid; grid-template-columns: 56px 1fr; gap: 12px; align-items: center; padding: 10px; text-align: start;
  border-radius: var(--pj-r-sm, 8px); border: 1px solid var(--color-edge-soft); background: var(--color-canvas);
  position: relative;
}
/* Hover edge drawn once as an inset ring and faded with opacity. */
.pjt-card::after {
  content: ""; position: absolute; inset: -1px; border-radius: inherit; pointer-events: none;
  box-shadow: inset 0 0 0 1px var(--color-edge); opacity: 0; transition: opacity .15s ease;
}
.pjt-card:hover::after { opacity: 1; }
.pjt-card[aria-checked="true"]::after { display: none; }
.pjt-card[aria-checked="true"] { border-color: var(--color-accent); box-shadow: inset 0 0 0 1px var(--color-accent); }
.pjt-card b { display: block; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--color-ink); }
.pjt-card small { display: block; font-size: 12px; line-height: 16px; color: var(--color-ink-muted); }
.pjt-chips { display: grid; grid-template-columns: repeat(4, 1fr); height: 36px; border-radius: 4px; overflow: hidden; box-shadow: 0 0 0 1px var(--color-edge); }
.pjt-type { grid-template-columns: 1fr; gap: 2px; }
.pjt-type-sample { display: block; margin-bottom: 4px; font-size: 28px; line-height: 34px; color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pjt-toggles { display: flex; flex-direction: column; }
.pjt-tog {
  display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; width: 100%; padding: 14px 0; text-align: start;
  border-bottom: 1px solid var(--color-edge-soft);
}
.pjt-tog-text b { display: block; font-size: 13px; line-height: 18px; font-weight: 600; color: var(--color-ink); }
.pjt-tog-text small { display: block; margin-top: 2px; font-size: 12px; line-height: 16px; color: var(--color-ink-muted); }
.pjt-switch { position: relative; width: 36px; height: 20px; border-radius: 999px; background: var(--color-raised); box-shadow: inset 0 0 0 1px var(--color-edge); }
.pjt-switch::after {
  content: ""; position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%;
  background: var(--color-ink-subtle); transition: transform .2s var(--pj-ease, ease);
}
.pjt-tog[aria-checked="true"] .pjt-switch { background: var(--color-accent); box-shadow: none; }
.pjt-tog[aria-checked="true"] .pjt-switch::after { transform: translateX(16px); background: var(--pj-on-accent, #fff); }
.pjt-stat { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: var(--pj-r-sm, 8px); background: var(--color-raised); font-size: 13px; }
.pjt-stat span { color: var(--color-ink-muted); }
.pjt-stat b { font-weight: 600; font-variant-numeric: tabular-nums; text-align: end; }
.pjt-text {
  width: 100%; height: 36px; padding: 0 12px; border-radius: var(--pj-r-sm, 8px); border: 1px solid var(--color-edge);
  background: var(--color-canvas); color: var(--color-ink); font-size: 13px;
}
.pjt-text::placeholder { color: var(--color-ink-subtle); opacity: 1; }
.pjt-status:empty { display: none; }
.pjt-status { margin-top: 12px; padding: 10px 12px; border-radius: var(--pj-r-sm, 8px); border: 1px solid var(--color-edge-soft); font-size: 13px; color: var(--color-ink); }
.pjt-pbody > .pjt-hint:last-child { margin-top: 18px; }

/* ---------- first-run welcome (top of the panel, first apply only) ---------- */
.pjt-welcome {
  flex: none; margin: 0 18px 12px; padding: 12px 14px; border-radius: var(--pj-r-sm, 8px);
  background: color-mix(in srgb, var(--color-accent) 12%, var(--color-elevated)); border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
  color: var(--color-ink-muted); font-size: 13px; line-height: 19px;
  animation: pj-tools-fade .3s var(--pj-ease, ease) both;
}
.pjt-welcome p { margin: 0; }
.pjt-welcome b { color: var(--color-ink); font-weight: 600; }

/* ---------- toast ---------- */
#projector-toast {
  position: fixed; left: 50%; bottom: 24px; z-index: 2150; margin: 0; max-width: min(460px, calc(100vw - 32px));
  padding: 10px 14px; border-radius: var(--pj-r-sm, 8px); background: var(--color-ink); color: var(--color-canvas);
  font-size: 13px; line-height: 18px; font-weight: 500; pointer-events: none;
  transform: translate(-50%, 12px); opacity: 0; transition: opacity .22s ease, transform .22s var(--pj-ease, ease);
}
#projector-toast.pjt-show { opacity: 1; transform: translate(-50%, 0); }
#projector-toast:empty { visibility: hidden; }

@media (max-width: 560px) {
  .pjt-scrim { padding-top: 8vh; }
  .pjt-pal-foot { display: none; }
}

/* 6. Posters and rows ----------------------------------------------------
   Small corners: Harbor's poster radius variable is set to 6px by js/00-core.js (it overrides Harbor's own
   poster-corner setting while Projector is on). Row titles are under Fragile at the end of this file. */
html[data-pj] .harbor-card-ring { box-shadow: 0 2px 8px -2px rgb(0 0 0 / .45), inset 0 0 0 1px rgb(255 255 255 / .05); }
html[data-pj][data-pj-scheme="light"] .harbor-card-ring { box-shadow: 0 2px 8px -3px rgb(0 0 0 / .25), inset 0 0 0 1px rgb(0 0 0 / .06); }
html[data-pj] .harbor-poster img { filter: var(--pj-grade); }

/* 7. Banner ---------------------------------------------------------------
   Harbor's banner is [data-scroll-anchor="hero"]. Projector frames it like a screen in a dark room: smaller corners
   (Fragile, below), a hairline frame, a deep shadow, and the film stock's grade on the artwork. The cinema layer
   (light spill, focus pull, title reveal, pointer tilt) arrives in milestone 2. */
html[data-pj] [data-scroll-anchor="hero"] img.object-cover { filter: var(--pj-grade); }
html[data-pj] [data-scroll-anchor="hero"] .font-display { font-weight: var(--pj-d-weight); font-stretch: var(--pj-d-stretch); letter-spacing: var(--pj-d-track); }

/* The banner's Play (Harbor's ink button) becomes the accent, the one bright thing on the screen. Only in the banner:
   elsewhere Harbor already pairs ink and accent buttons, and turning both accent made them look the same. The
   carousel dots are also .bg-ink (h-1.5) and stay as they are. */
html[data-pj] [data-scroll-anchor="hero"] button.bg-ink:not(.h-1\.5) {
  background-color: var(--color-accent) !important;
  color: var(--pj-on-accent) !important;
  box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--color-accent) 75%, transparent);
}
html[data-pj] [data-scroll-anchor="hero"] button.bg-ink:not(.h-1\.5):hover { filter: brightness(1.07); }

/* 8. Detail page (credits layout) -----------------------------------------
   The crew grid reads like opening credits: centered, the role in a small italic serif, the names in the display
   serif. Selectors are under Fragile, below. */


/* ---- Fragile: banner, rows, credits ---------------------------------------------------- */
/* Banner corners. Checked against Harbor 0.9.113 components/hero.tsx: the frame is .rounded-[28px], the image is
   inset 2px with .rounded-[26px]; the carousel viewport (home.tsx) is also .rounded-[28px]. */
html[data-pj] [data-scroll-anchor="hero"] .rounded-\[28px\] {
  border-radius: 14px !important;
  box-shadow: inset 0 0 0 1px rgb(255 255 255 / .07), 0 40px 80px -40px rgb(0 0 0 / .9);
}
html[data-pj] [data-scroll-anchor="hero"] .rounded-\[26px\] { border-radius: 12px !important; }

/* Row titles. Checked against Harbor 0.9.113 components/row.tsx: an h3 with "truncate font-medium tracking-tight"
   and an inline font size from Harbor's row-title-scale setting, which is kept. */
html[data-pj] h3.truncate.font-medium.tracking-tight { font-weight: 650; letter-spacing: -.005em; }

/* Credits. Checked against Harbor 0.9.113 views/detail.tsx and detail/credit.tsx: the crew is a .grid of
   Credit blocks (.flex-col), each a role label span (uppercase, tracked) and a names span holding
   [data-person-card] buttons. */
html[data-pj] .grid:has(> .flex-col > span > span > [data-person-card]) { justify-items: center; text-align: center; row-gap: 28px; }
html[data-pj] .grid:has(> .flex-col > span > span > [data-person-card]) > .flex-col { align-items: center; gap: 4px; }
html[data-pj] .grid:has(> .flex-col > span > span > [data-person-card]) > .flex-col > span:first-child {
  font-family: var(--font-display); font-style: italic; font-size: 14px; line-height: 18px;
  text-transform: none; letter-spacing: 0; color: var(--color-ink-subtle);
}
html[data-pj] .grid:has(> .flex-col > span > span > [data-person-card]) > .flex-col > span:last-child {
  font-family: var(--font-display); font-weight: var(--pj-d-weight); font-stretch: var(--pj-d-stretch); letter-spacing: var(--pj-d-track);
  font-size: 21px; line-height: 28px; text-wrap: balance;
}

/* Signature pieces: the projector beam on posters, the light leak between pages, sprocket progress, the projector
   flicker on loading placeholders, title-card headings, playbill details and the showtimes calendar.
   Icons are in js/25-icons.js (their style sheet is built there). Switches: html[data-pj-beam], [data-pj-leak]
   (set from js/70-signature.js) and [data-pj-motion]. Only transform and opacity animate; every gradient is static. */

/* ---------- projector beam ----------
   A soft cone of light falls from just above the poster you point at (or reach with the keyboard), like the
   projector hitting the screen. Static gradient, faded in by opacity. Drawn inside Harbor's poster box
   (.harbor-poster is relative and clips), so rows never clip it and nothing moves. */
/* Two layers: the shaft ([data-preview-anchor]::after) starts in the dark just above the poster with faint ray
   streaks and lands on it; the hotspot (.harbor-poster::before) is where it hits, a warm pool at the top of the
   artwork. Both are tinted toward the poster's own color (--pj-glow) and add light (screen) in dark mode. */
/* Set on the poster itself, where --pj-glow lives (a variable built from another resolves where it is declared). */
html[data-pj] [data-preview-anchor] { --pj-beam-tint: color-mix(in srgb, var(--pj-glow, #ffe2b8) 35%, #fff4e2); --pj-beam-a: .34; }
html[data-pj][data-pj-scheme="light"] [data-preview-anchor] { --pj-beam-tint: color-mix(in srgb, var(--pj-glow, var(--color-accent)) 60%, #fff); --pj-beam-a: .5; }
html[data-pj-beam="on"] [data-preview-anchor]::after {
  content: ""; position: absolute; left: -12%; right: -12%; top: -22px; height: 78%; z-index: 4; pointer-events: none;
  background:
    repeating-conic-gradient(from 160deg at 50% -6%, transparent 0 2.2deg, rgb(255 255 255 / .07) 2.6deg, transparent 3.4deg 5deg),
    conic-gradient(from 0deg at 50% -6%, transparent 0 152deg,
      color-mix(in srgb, var(--pj-beam-tint) calc(var(--pj-beam-a) * 60%), transparent) 166deg,
      color-mix(in srgb, var(--pj-beam-tint) calc(var(--pj-beam-a) * 100%), transparent) 180deg,
      color-mix(in srgb, var(--pj-beam-tint) calc(var(--pj-beam-a) * 60%), transparent) 194deg, transparent 208deg 360deg);
  -webkit-mask: linear-gradient(to bottom, transparent 0, #000 16%, rgb(0 0 0 / .6) 55%, transparent 100%);
  mask: linear-gradient(to bottom, transparent 0, #000 16%, rgb(0 0 0 / .6) 55%, transparent 100%);
  mix-blend-mode: screen; opacity: 0; transition: opacity .4s var(--pj-ease, ease);
}
html[data-pj-beam="on"][data-pj-scheme="light"] [data-preview-anchor]::after { mix-blend-mode: normal; }
html[data-pj-beam="on"] [data-preview-anchor] .harbor-poster::before {
  content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
  background: radial-gradient(70% 42% at 50% 0%, color-mix(in srgb, var(--pj-beam-tint) 55%, transparent), transparent 100%);
  mix-blend-mode: screen; opacity: 0; transition: opacity .4s var(--pj-ease, ease);
}
html[data-pj-beam="on"][data-pj-scheme="light"] [data-preview-anchor] .harbor-poster::before { mix-blend-mode: soft-light; }
html[data-pj-beam="on"] .group:is(:hover, :focus-visible) [data-preview-anchor]::after,
html[data-pj-beam="on"] [data-tv-focused] [data-preview-anchor]::after,
html[data-pj-beam="on"] .group:is(:hover, :focus-visible) [data-preview-anchor] .harbor-poster::before,
html[data-pj-beam="on"] [data-tv-focused] [data-preview-anchor] .harbor-poster::before { opacity: 1; }
/* A faint lamp flicker in the shaft while it is lit (opacity only, never below 85%). */
@keyframes pj-beam-flicker { 0%, 100% { opacity: 1; } 31% { opacity: .9; } 34% { opacity: 1; } 62% { opacity: .86; } 66% { opacity: .97; } }
html[data-pj-beam="on"][data-pj-motion="on"] .group:is(:hover, :focus-visible) [data-preview-anchor]::after {
  animation: pj-beam-flicker 3.4s linear .4s infinite;
}
html[data-pj-motion="off"] [data-preview-anchor]::after,
html[data-pj-motion="off"] [data-preview-anchor] .harbor-poster::before { transition: none; }

/* ---------- light leak between pages ----------
   One warm band sweeps across once when the page changes (js/70-signature.js adds the layer for 0.8 s). Under
   Harbor's back button (z 70) and window controls; hidden with the rest of projector-layer* during playback. */
#projector-layer-leak { position: fixed; inset: 0; z-index: 65; pointer-events: none; overflow: hidden; }
#projector-layer-leak::before {
  content: ""; position: absolute; top: -10%; bottom: -10%; left: -80%; width: 80%; opacity: 0;
  background: linear-gradient(100deg, transparent 0%, rgb(255 170 96 / .06) 30%,
    color-mix(in srgb, var(--color-accent) 12%, transparent) 50%, rgb(255 236 206 / .05) 64%, transparent 100%);
}
html[data-pj-scheme="light"] #projector-layer-leak::before {
  background: linear-gradient(100deg, transparent 0%, rgb(255 170 96 / .05) 30%,
    color-mix(in srgb, var(--color-accent) 8%, transparent) 50%, transparent 100%);
}
#projector-layer-leak[data-run="a"]::before { animation: pj-leak-a 1.1s cubic-bezier(.4, .2, .3, 1) both; }
#projector-layer-leak[data-run="b"]::before { animation: pj-leak-b 1.1s cubic-bezier(.4, .2, .3, 1) both; }
@keyframes pj-leak-a { 0% { transform: translateX(0); opacity: 0; } 35% { opacity: 1; } 100% { transform: translateX(225%); opacity: 0; } }
@keyframes pj-leak-b { 0% { transform: translateX(0); opacity: 0; } 35% { opacity: 1; } 100% { transform: translateX(225%); opacity: 0; } }

/* ---------- title-card headings ----------
   Page headings get a short lit rule above them, like a title card. No words, so it works in every language. */
html[data-pj]:not([data-chrome-hidden]) main h1.font-display:not(.flex):not([data-scroll-anchor="hero"] h1)::before {
  content: ""; display: block; width: 32px; height: 2px; margin-bottom: 12px; border-radius: 1px;
  background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 0%, transparent));
}

/* ---------- Fragile (Harbor 0.9.113) ---------- */

/* Sprocket progress (ContinueCard and episode cards): the progress track becomes a row of film perforations; the
   watched part stays a solid accent line on top. Overrides the 2px track from css/40-features.css. */
html[data-pj] :is(.harbor-poster, [data-ep] .rounded-lg) > .absolute.inset-x-0.bottom-0.h-\[3px\] {
  height: 3px !important;
  background: repeating-linear-gradient(90deg, color-mix(in srgb, var(--color-ink) 30%, transparent) 0 5px, transparent 5px 8px) !important;
}

/* Projector flicker: Harbor's loading placeholders (Tailwind animate-pulse) flicker unevenly, like a lamp warming
   up, instead of a smooth pulse. Opacity only; still with motion off. */
@keyframes pj-flicker {
  0%, 100% { opacity: .5; } 7% { opacity: .74; } 9% { opacity: .46; } 23% { opacity: .68; } 41% { opacity: .6; }
  43% { opacity: .82; } 46% { opacity: .55; } 71% { opacity: .7; } 88% { opacity: .5; }
}
html[data-pj][data-pj-motion="on"] main .animate-pulse { animation: pj-flicker 2.8s linear infinite !important; }
html[data-pj][data-pj-motion="off"] main .animate-pulse { animation: none !important; opacity: .6; }

/* Playbill details (views/detail.tsx heroPills, detail/pill.tsx): year, ratings and runtime read like a line from a
   theater program: one strip between hairlines, the items split by perforations, numbers in the display face. */
html[data-pj] main .mt-6.flex.flex-wrap.items-center.gap-3.text-\[13px\]:has(.rounded-full.border-edge-soft.bg-canvas\/85) {
  gap: 8px 0 !important; width: fit-content; max-width: 100%; padding-block: 9px;
  border-block: 1px solid color-mix(in srgb, var(--color-ink) 16%, transparent);
  font-family: var(--font-display); font-size: 15px; letter-spacing: .03em; font-variant-numeric: lining-nums tabular-nums;
}
html[data-pj] main .mt-6.flex.flex-wrap.items-center.gap-3.text-\[13px\]:has(.rounded-full.border-edge-soft.bg-canvas\/85) > * {
  /* !important: the items are often Harbor's pills, whose padding is cleared below. */
  padding-inline: 14px !important; border-inline-start: 1px dashed color-mix(in srgb, var(--color-ink) 34%, transparent);
}
html[data-pj] main .mt-6.flex.flex-wrap.items-center.gap-3.text-\[13px\]:has(.rounded-full.border-edge-soft.bg-canvas\/85) > :first-child {
  padding-inline-start: 0 !important; border-inline-start: 0;
}
html[data-pj] main .mt-6.flex.flex-wrap.gap-3 .rounded-full.border.border-edge-soft.bg-canvas\/85 {
  padding: 0 !important; border-color: transparent !important; border-radius: 3px !important; background: transparent !important;
  color: var(--color-ink); transform: none !important;
}
html[data-pj] main .mt-6.flex.flex-wrap.gap-3 button.rounded-full.border.border-edge-soft.bg-canvas\/85:hover { color: var(--color-accent); }

/* Showtimes calendar (views/calendar/month-grid.tsx, calendar-chip.tsx): day numbers in the display face, weekday
   names as italic serif (like the credits), today lit like a marquee, each title a slip with an accent edge. */
html[data-pj] main .grid.grid-cols-7.gap-2 > .text-\[11px\].uppercase {
  text-transform: none; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 14px; letter-spacing: 0;
}
html[data-pj] main .grid.grid-cols-7.gap-2 > .flex.min-h-\[112px\].rounded-xl { border-radius: 6px !important; }
html[data-pj] main .grid.grid-cols-7.gap-2 > .flex.min-h-\[112px\] > .flex.items-baseline > span.tabular-nums:first-child {
  font-family: var(--font-display); font-weight: var(--pj-d-weight, 600); font-stretch: var(--pj-d-stretch, 100%); font-size: 21px; line-height: 1;
}
html[data-pj] main .grid.grid-cols-7.gap-2 > .flex.min-h-\[112px\].border-ink\/60 {
  border-color: color-mix(in srgb, var(--color-accent) 55%, transparent) !important;
  background: color-mix(in srgb, var(--color-accent) 8%, var(--color-elevated)) !important;
  box-shadow: inset 0 2px 0 var(--color-accent), 0 0 26px -10px var(--color-accent);
}
html[data-pj] main .grid.grid-cols-7.gap-2 > .flex.min-h-\[112px\].border-ink\/60 > .flex.items-baseline > span.tabular-nums:first-child { color: var(--color-accent); }
html[data-pj] main .group.relative.flex.min-w-0.items-center.gap-2.rounded-md.bg-canvas\/50 {
  border-radius: 3px !important; border-inline-start: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
}

/* ---------- scene fade between pages (on by default) ----------
   A soft dip, like a gentle cut between scenes: the new page starts slightly dimmed with a darker edge and clears
   in under half a second. One layer, opacity only, there only while it runs (js/70-signature.js). */
#projector-layer-curtain { position: fixed; inset: 0; z-index: 66; pointer-events: none; opacity: 0;
  background: radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--color-canvas) 55%, transparent) 0%, var(--color-canvas) 100%); }
#projector-layer-curtain[data-run="a"] { animation: pj-scene-a .5s cubic-bezier(.25, .6, .3, 1) both; }
#projector-layer-curtain[data-run="b"] { animation: pj-scene-b .5s cubic-bezier(.25, .6, .3, 1) both; }
@keyframes pj-scene-a { from { opacity: .55; } to { opacity: 0; } }
@keyframes pj-scene-b { from { opacity: .55; } to { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { #projector-layer-curtain { display: none; } }

@html
<!-- Intentionally empty. Harbor's overlay is aria-hidden, so Projector builds anything interactive from theme.js. -->

@js
/* Projector for Harbor, v0.1.0
   Runs once when the theme loads (Harbor calls it with new Function).
   Everything it adds is removed again by window.__harborThemeCleanup.
   This file: helpers, color, film stocks, type, settings, appearance, Harbor tokens, module hooks, the banner reader.
   The theme is built by joining projector/src/js/*.js in name order (build/build.mjs). Plan: docs/projector-plan.md. */
(() => {
  "use strict";
  const VERSION = "0.1.0";
  const KEY = "projector.settings.v1";
  const SCHEMA = 1;
  const doc = document, root = doc.documentElement, win = window;

  if (typeof win.__projectorDispose === "function") { try { win.__projectorDispose(); } catch (e) { /* stale instance */ } }

  /* ---------- small helpers ---------- */
  let disposed = false;
  const cleanups = [];
  const listen = (t, ev, fn, opt) => { t.addEventListener(ev, fn, opt); cleanups.push(() => t.removeEventListener(ev, fn, opt)); };
  const every = (ms, fn) => { const id = setInterval(fn, ms); cleanups.push(() => clearInterval(id)); };
  const el = (tag, attrs) => { const n = doc.createElement(tag); if (attrs) for (const k in attrs) n.setAttribute(k, attrs[k]); return n; };
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const store = {
    get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* storage full or blocked */ } },
  };
  const mq = (q) => (win.matchMedia ? win.matchMedia(q) : null);
  const lightMQ = mq("(prefers-color-scheme: light)");
  const reduceMQ = mq("(prefers-reduced-motion: reduce)");
  const onMQ = (m, fn) => { if (!m) return; m.addEventListener("change", fn); cleanups.push(() => m.removeEventListener("change", fn)); };

  /* ---------- color math ---------- */
  const hexToRgb = (h) => { const n = parseInt(h.slice(1, 7), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
  const rgbToHex = (c) => "#" + c.map((v) => clamp(Math.round(v), 0, 255).toString(16).padStart(2, "0")).join("");
  const mixHex = (a, b, t) => { const x = hexToRgb(a), y = hexToRgb(b); return rgbToHex(x.map((v, i) => v + (y[i] - v) * t)); };
  const lum = (h) => { const c = hexToRgb(h).map((v) => { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
  function rgbToHsl([r, g, b]) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b), l = (max + min) / 2;
    if (max === min) return [0, 0, l];
    const d = max - min, s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    const h = max === r ? (g - b) / d + (g < b ? 6 : 0) : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
    return [h * 60, s, l];
  }
  function hslToHex(h, s, l) {
    const k = (n) => (n + h / 30) % 12, a = s * Math.min(l, 1 - l);
    const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
    return rgbToHex([f(0) * 255, f(8) * 255, f(4) * 255]);
  }
  const mixTokens = (a, b, t) => { const o = {}; for (const k in a) o[k] = mixHex(a[k], b[k], t); return o; };
  const contrast = (a, b) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
  // Moves a text color toward the ink until it reaches `min` against every surface it can sit on.
  function readable(fg, surfaces, min, toward) {
    let c = fg;
    for (let i = 0; i < 24 && surfaces.some((s) => contrast(c, s) < min); i++) c = mixHex(c, toward, 0.08);
    return c;
  }
  const smooth = (a, b, x) => { const t = clamp((x - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };

  /* ---------- film stocks (values from the mockup, mockups/projector/projector.js) ---------- */
  const STOCKS = {
    neutral: {
      name: "Neutral", grade: "none",
      dark: { canvas: "#131314", surface: "#19191b", elevated: "#212124", raised: "#2a2a2e", ink: "#efeee9", muted: "#a8a7a1", subtle: "#8a8983", accent: "#e9c37f" },
      // Light is "house lights half up": soft mid-light rooms, never paper white, so artwork keeps its punch.
      light: { canvas: "#d0cfcb", surface: "#c6c5c1", elevated: "#dad9d5", raised: "#bdbcb6", ink: "#141416", muted: "#41403c", subtle: "#4a4944", accent: "#6a4209" },
    },
    warm: {
      name: "Warm print", grade: "sepia(.16) saturate(1.06)",
      dark: { canvas: "#17120f", surface: "#1f1915", elevated: "#28201b", raised: "#332922", ink: "#f4e9dc", muted: "#bba996", subtle: "#9a8775", accent: "#f0a85a" },
      light: { canvas: "#d4caba", surface: "#cbc0ae", elevated: "#ded5c8", raised: "#c1b49f", ink: "#22180f", muted: "#4c3c29", subtle: "#534231", accent: "#6e350a" },
    },
    cool: {
      name: "Cool", grade: "saturate(.88) hue-rotate(8deg)",
      dark: { canvas: "#0f1216", surface: "#151a20", elevated: "#1d232b", raised: "#262d37", ink: "#e8eef5", muted: "#9eaab8", subtle: "#7d8998", accent: "#86b9ea" },
      light: { canvas: "#cbd1d8", surface: "#c2c8d1", elevated: "#d6dbe1", raised: "#b7bfc9", ink: "#0f1620", muted: "#3a4655", subtle: "#414b59", accent: "#1c4775" },
    },
    mono: {
      name: "Mono", grade: "none", fixedAccent: true,
      dark: { canvas: "#111111", surface: "#181818", elevated: "#202020", raised: "#2b2b2b", ink: "#f2f2f2", muted: "#a8a8a8", subtle: "#8a8a8a", accent: "#f2f2f2" },
      light: { canvas: "#cfcfcf", surface: "#c5c5c5", elevated: "#d9d9d9", raised: "#bbbbbb", ink: "#111111", muted: "#3f3f3f", subtle: "#484848", accent: "#111111" },
    },
    faded: {
      name: "Faded", grade: "contrast(.86) saturate(.8) brightness(1.05)",
      dark: { canvas: "#1d1c1f", surface: "#242327", elevated: "#2d2c31", raised: "#38363c", ink: "#e7e3dc", muted: "#aaa59e", subtle: "#8f8a84", accent: "#dba9a2" },
      light: { canvas: "#ccc8c2", surface: "#c3beb6", elevated: "#d5d3cd", raised: "#b9b4aa", ink: "#2a292c", muted: "#47443f", subtle: "#47433f", accent: "#653632" },
    },
  };
  // Evening and early-morning targets for "Follow time of day".
  const WARM_DARK = { canvas: "#211a15", surface: "#29211b", elevated: "#322822", raised: "#3c3029", ink: "#f4e9dc", muted: "#bba996", subtle: "#9f8c79", accent: "#f0a85a" };
  const WARM_LIGHT = { canvas: "#d0c4b4", surface: "#c6b9a5", elevated: "#dad0c1", raised: "#bcad96", ink: "#22180f", muted: "#4a3a28", subtle: "#4d3d2d", accent: "#673107" };

  const TYPES = {
    premiere: { name: "Premiere", family: "Bodoni+Moda:opsz,wght@6..96,400..700&family=Schibsted+Grotesk:wght@400..700", display: '"Bodoni Moda", Georgia, "Times New Roman", serif', sans: '"Schibsted Grotesk", system-ui, "Segoe UI", sans-serif', weight: 500, stretch: "100%", track: "-0.015em" },
    paperback: { name: "Paperback", family: "Brygada+1918:wght@400..700&family=Albert+Sans:wght@400..700", display: '"Brygada 1918", Georgia, serif', sans: '"Albert Sans", system-ui, "Segoe UI", sans-serif', weight: 600, stretch: "100%", track: "-0.01em" },
    titlecard: { name: "Title card", family: "Archivo:wdth,wght@62..125,400..800", display: '"Archivo", "Arial Narrow", sans-serif', sans: '"Archivo", system-ui, "Segoe UI", sans-serif', weight: 760, stretch: "68%", track: "-0.005em" },
    harbor: { name: "Harbor's fonts", family: "", display: "", sans: "", weight: 600, stretch: "100%", track: "-0.01em" },
  };

  /* ---------- settings ---------- */
  const DEFAULTS = {
    schema: SCHEMA,
    appearance: "dark",   // dark | light | time | windows
    dawn: 7, dusk: 18,    // hours for "time"; the page switches family once at each
    stock: "neutral",
    type: "premiere",
    accent: "artwork",    // artwork | stock
    motion: "system",     // on | off | system
    // Cinema layer (milestone 2). Toggles in the panel's Cinema tab.
    spill: true, focus: true, reveal: true, lights: true, glow: true, rise: true, parallax: true,
    icons: true, beam: true, leak: true,   // signature pieces (js/25-icons.js, js/70-signature.js)
    wide: false, grain: false,
    brand: true, bulbs: true, curtain: true, grow: true,   // streaming tile glow, Continue Watching bulbs, curtain between pages
    perf: "auto",         // auto | balanced | lite (milestone 4 panel, Speed tab)
    navPos: "left",       // left | top | bottom: where Harbor's sidebar sits (js/20-nav.js, css/20-nav.css)
  };
  const BOOLS = ["spill", "focus", "reveal", "lights", "glow", "rise", "parallax", "wide", "grain", "icons", "beam", "leak", "brand", "bulbs", "curtain", "grow"];
  function load() {
    let s = {};
    try { s = JSON.parse(store.get(KEY) || "{}") || {}; } catch (e) { s = {}; }
    return normalize(s);
  }
  function normalize(s) {
    const o = Object.assign({}, DEFAULTS, s, { schema: SCHEMA });
    if (!["dark", "light", "time", "windows"].includes(o.appearance)) o.appearance = DEFAULTS.appearance;
    if (!STOCKS[o.stock]) o.stock = DEFAULTS.stock;
    if (!TYPES[o.type]) o.type = DEFAULTS.type;
    if (!["artwork", "stock"].includes(o.accent)) o.accent = DEFAULTS.accent;
    if (!["on", "off", "system"].includes(o.motion)) o.motion = DEFAULTS.motion;
    o.dawn = clamp(Number(o.dawn) || DEFAULTS.dawn, 3, 11);
    o.dusk = clamp(Number(o.dusk) || DEFAULTS.dusk, 15, 23);
    for (const k of BOOLS) if (typeof o[k] !== "boolean") o[k] = DEFAULTS[k];
    if (!["auto", "balanced", "lite"].includes(o.perf)) o.perf = DEFAULTS.perf;
    if (!["left", "top", "bottom"].includes(o.navPos)) o.navPos = DEFAULTS.navPos;
    delete o.navStyle; // mirrors Harbor's own sidebarCollapsed setting, never stored by the theme
    return o;
  }
  const state = load();
  let saveTimer = 0;
  const save = () => { clearTimeout(saveTimer); saveTimer = setTimeout(() => store.set(KEY, JSON.stringify(state)), 250); };
  // For testing on the bench before the panel exists: __projector.set({ appearance: "light" }).
  // hourOverride is not saved; it fakes the clock for "Follow time of day".
  let hourOverride = null;

  /* ---------- appearance ---------- */
  function hourNow() {
    if (hourOverride != null) return hourOverride;
    const d = new Date();
    return d.getHours() + d.getMinutes() / 60;
  }
  function palette() {
    const st = STOCKS[state.stock];
    const a = state.appearance;
    if (a === "light") return { t: st.light, light: true };
    if (a === "windows") { const light = !!(lightMQ && lightMQ.matches); return { t: light ? st.light : st.dark, light }; }
    if (a === "time") {
      // Readable at every moment: the page switches family once at dawn and once at dusk and only drifts warmer or
      // cooler within a family. A continuous light-to-dark blend passes through a middle where ink and canvas are
      // too close to read (found in the mockup).
      const h = hourNow(), dawn = state.dawn, dusk = state.dusk;
      if (h >= dawn && h < dusk) {
        const warm = h < dawn + 2 ? (1 - smooth(dawn, dawn + 2, h)) * 0.6 : smooth(dusk - 3.5, dusk, h) * 0.85;
        return { t: mixTokens(st.light, WARM_LIGHT, warm), light: true };
      }
      const warm = h >= dusk ? 1 - smooth(dusk, dusk + 4.5, h) : smooth(dawn - 2.5, dawn, h) * 0.6;
      return { t: mixTokens(st.dark, WARM_DARK, warm), light: false };
    }
    return { t: st.dark, light: false };
  }

  // Set by the artwork sampler (js/30-cinema.js) through setArtColor(). Until then the stock's accent is used.
  let artColor = null;
  function setArtColor(rgb) { artColor = rgb; apply(); }
  function accentFor(light, fallback) {
    if (STOCKS[state.stock].fixedAccent || state.accent !== "artwork" || !artColor) return fallback;
    const [h, s] = rgbToHsl(artColor);
    if (s < 0.12) return fallback;
    return hslToHex(h, clamp(s, 0.42, 0.78), light ? 0.36 : 0.7);
  }

  /* ---------- module hooks ----------
     The source is split by area (js/20-nav.js, 30-cinema.js, 40-features.js, 50-tools.js); the build joins the files
     in name order inside this one function, so they all share what is declared here. A module registers:
       hooks.apply   (light) => void   after colors and settings are written (set data-pj-* switches here)
       hooks.scan    () => void        every 1.5 s and on page changes, only while visible and not playing
       hooks.player  (on) => void      when Harbor's player mounts (true) or unmounts (false)
       hooks.dispose () => void        on unload: remove every node, listener and attribute the module added */
  const hooks = { apply: [], scan: [], player: [], dispose: [] };
  const runHooks = (list, arg) => list.forEach((f) => { try { f(arg); } catch (e) { console.warn("[projector]", e); } });
  function runScan() {
    if (disposed || doc.hidden || root.hasAttribute("data-chrome-hidden")) return;
    runHooks(hooks.scan);
  }

  /* ---------- DOM we own ---------- */
  const varsStyle = el("style", { id: "projector-vars" });
  const fontLink = el("link", { rel: "stylesheet", id: "projector-fonts" });
  doc.head.append(fontLink, varsStyle);

  const ATTRS = new Set();
  const setAttr = (k, v) => { ATTRS.add(k); if (root.getAttribute("data-" + k) !== v) root.setAttribute("data-" + k, v); };
  const motionOn = () => state.motion === "on" || (state.motion === "system" && !(reduceMQ && reduceMQ.matches));

  let lastVars = "";
  function apply() {
    if (disposed) return;
    const p = palette(), light = p.light, t = Object.assign({}, p.t);
    // Text contrast at least 4.5:1 (accent 3:1) on all four surfaces, in every stock, mode and time-of-day blend.
    const surfaces = [t.canvas, t.surface, t.elevated, t.raised];
    t.muted = readable(t.muted, surfaces, 4.5, t.ink);
    t.subtle = readable(t.subtle, surfaces, 4.5, t.ink);
    const accent = readable(accentFor(light, t.accent), surfaces, 3, t.ink);
    const ink = hexToRgb(t.ink);
    const a = (n) => Math.round(n * 255).toString(16).padStart(2, "0");
    const ty = TYPES[state.type];
    const tokens = {
      "--color-canvas": t.canvas, "--color-surface": t.surface, "--color-elevated": t.elevated, "--color-raised": t.raised,
      "--color-ink": t.ink, "--color-ink-muted": t.muted, "--color-ink-subtle": t.subtle,
      "--color-edge": rgbToHex(ink) + a(light ? 0.13 : 0.1), "--color-edge-soft": rgbToHex(ink) + a(light ? 0.08 : 0.06),
      "--color-accent": accent, "--color-accent-soft": accent + "2e", "--color-danger": light ? "#c0392f" : "#f0716b",
    };
    let css = ":root{";
    for (const k in tokens) css += `${k}:${tokens[k]} !important;`;
    if (ty.display) css += `--font-display:${ty.display} !important;--font-sans:${ty.sans} !important;`;
    css += `--pj-on-accent:${contrast(accent, "#16130e") >= contrast(accent, "#ffffff") ? "#16130e" : "#ffffff"};--pj-grade:${STOCKS[state.stock].grade};` +
      `--pj-d-weight:${ty.weight};--pj-d-stretch:${ty.stretch};--pj-d-track:${ty.track};--poster-radius:6px !important;` +
      `color-scheme:${light ? "light" : "dark"};}`;
    // Light mode keeps the banner a dark screen with the house lights up around it: inside the banner Harbor's own
    // tokens switch to the stock's dark set, so its fades run to near-black, the art keeps its color and white
    // title logos stay readable.
    if (light) {
      const d = STOCKS[state.stock].dark, dAcc = readable(accentFor(false, d.accent), [d.canvas, d.surface], 3, d.ink), dInk = hexToRgb(d.ink);
      css += `[data-scroll-anchor="hero"]{--color-canvas:${d.canvas} !important;--color-surface:${d.surface} !important;` +
        `--color-elevated:${d.elevated} !important;--color-raised:${d.raised} !important;--color-ink:${d.ink} !important;` +
        `--color-ink-muted:${readable(d.muted, [d.canvas], 4.5, d.ink)} !important;--color-ink-subtle:${readable(d.subtle, [d.canvas], 4.5, d.ink)} !important;` +
        `--color-edge:${rgbToHex(dInk)}1a !important;--color-edge-soft:${rgbToHex(dInk)}0f !important;--color-accent:${dAcc} !important;` +
        `--pj-on-accent:${contrast(dAcc, "#16130e") >= contrast(dAcc, "#ffffff") ? "#16130e" : "#ffffff"};color-scheme:dark;color:var(--color-ink);}`;
    }
    if (css !== lastVars) { varsStyle.textContent = css; lastVars = css; }
    const href = ty.family ? `https://fonts.googleapis.com/css2?family=${ty.family}&display=swap` : "";
    if (href && fontLink.getAttribute("href") !== href) fontLink.setAttribute("href", href);
    if (!href && fontLink.hasAttribute("href")) fontLink.removeAttribute("href");
    setAttr("pj", VERSION);
    setAttr("pj-scheme", light ? "light" : "dark");
    setAttr("pj-stock", state.stock);
    setAttr("pj-type", state.type);
    setAttr("pj-motion", motionOn() ? "on" : "off");
    runHooks(hooks.apply, light);
  }
  function set(patch) {
    Object.assign(state, normalize(Object.assign({}, state, patch)));
    save();
    apply();
  }

  /* ---------- the banner: what is showing ----------
     Harbor's home banner is [data-scroll-anchor="hero"]; the visible slide is the one with aria-hidden="false". Its
     title is a logo image (alt = title) or a heading. Checked against Harbor 0.9.113 components/hero.tsx. */
  function bannerNow() {
    const hero = doc.querySelector('[data-scroll-anchor="hero"]');
    if (!hero) return null;
    const slide = hero.querySelector('[aria-hidden="false"]') || hero;
    const img = slide.querySelector("img.object-cover");
    const src = img && (img.currentSrc || img.src);
    if (!src) return null;
    const head = slide.querySelector("h1, h2");
    const logo = slide.querySelector('img[alt]:not([alt=""]):not(.object-cover)');
    const title = (head && head.textContent.trim()) || (logo && logo.alt.trim()) || "";
    return { src, title };
  }

  /* ===== js/20-nav.js: Marquee navigation (styles Harbor's own sidebar) ===== */

  /* ---------- Marquee: "Now showing" in Harbor's sidebar ---------- */
  const now = el("div", { id: "projector-now", "aria-hidden": "true", hidden: "" });
  now.innerHTML = '<div class="pj-now-art"><img alt="" decoding="async"></div><p class="pj-now-kicker">Now showing</p><p class="pj-now-title"></p>';
  const nowImg = now.querySelector("img"), nowTitle = now.querySelector(".pj-now-title");
  let nowSrc = "";
  // Harbor owns the sidebar and unmounts it on Settings and during playback, so the block is put back whenever
  // the sidebar returns. It goes right under Harbor's logo, never between React's own nav items.
  function placeNow() {
    const aside = doc.querySelector("aside[data-harbor-sidebar]");
    if (!aside) return;
    const logo = [...aside.children].find((c) => c !== now);
    if (logo && now.previousElementSibling !== logo) aside.insertBefore(now, logo.nextSibling);
  }
  function scanNow() {
    placeNow();
    const b = bannerNow();
    if (!b || b.src === nowSrc) return;
    nowSrc = b.src;
    nowImg.src = b.src;
    nowTitle.textContent = b.title;
    now.hidden = false;
    now.classList.remove("pj-swap");
    void now.offsetWidth; // restart the fade
    now.classList.add("pj-swap");
  }

  hooks.scan.push(scanNow);
  hooks.dispose.push(() => now.remove());

  /* ---------- navigation style and position ----------
     Style (Marquee with names, or Icons only) is Harbor's own sidebarCollapsed setting: the panel reads it from
     aside[data-collapsed] and changes it by pressing Harbor's collapse button, so Harbor stays the owner and its
     own button keeps working. Position (left, top or bottom) is the theme's: data-pj-nav lays Harbor's sidebar
     out as a bar (css/20-nav.css). Below 1024px Harbor always shows icons only. */
  const navAside = () => doc.querySelector("aside[data-harbor-sidebar]");
  const navStyleNow = () => { const a = navAside(); return a && a.getAttribute("data-collapsed") === "false" ? "marquee" : "icons"; };
  function setNavStyle(v) {
    const a = navAside(), t = a && a.querySelector("[data-harbor-sidebar-toggle]");
    if (t && navStyleNow() !== v) t.click();
  }
  hooks.apply.push(() => setAttr("pj-nav", state.navPos));

  /* ===== js/25-icons.js: Projector icons for Harbor's sidebar =====
     Harbor still draws every nav button (chrome/nav-items.tsx, 0.9.113: a fixed list of views, no user-made entries).
     Projector only paints a different picture on each one: Harbor's svg is made invisible (it keeps its size, so the
     layout doesn't move) and a CSS mask in the same box draws the new line icon in the button's own color. Badges
     (downloads count, calendar reminders, the parental lock) are separate elements and stay on top. The style sheet
     is built once here, so the icons live in one readable list; html[data-pj-icons] switches them, set from the
     panel's "Projector icons". Drawn on a 24px grid, 1.6px round strokes, film and theater shapes. */
  {
    const S = (body) => `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
    const P = (d) => `<path d="${d}"/>`, O = (cx, cy, r) => `<circle cx="${cx}" cy="${cy}" r="${r}"/>`;
    const R = (x, y, w, h, rx) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${rx}"/>`;
    const ICONS = {
      // A theater front: roof, a marquee board with bulbs, the doors.
      home: P("M3.5 9.5 12 4l8.5 5.5") + R(5, 9.5, 14, 3.5, 0.6) + P("M6 13v7.5h12V13M10.5 20.5V17h3v3.5") + P("M8 11.25h.01M10.67 11.25h.01M13.33 11.25h.01M16 11.25h.01"),
      // A spotlight throwing a cone onto the floor.
      discover: P("M4.2 6.6 7.1 3.7l3.4 3.4-2.9 2.9z") + P("M7.9 9.8 11.6 20.3M10.3 7.4l10 4.4") + P("M11.6 20.3c4.6.2 8.4-3.6 8.7-8.5") + P("M5.2 9 3.6 11.4"),
      // A film reel with a tail of film.
      catalogs: O(12, 11, 8) + O(12, 11, 1.3) + O(12, 6.6, 1.5) + O(16.2, 9.6, 1.5) + O(14.6, 14.6, 1.5) + O(9.4, 14.6, 1.5) + O(7.8, 9.6, 1.5) + P("M14 19h6.5"),
      // A film frame with sprocket holes.
      movies: R(3.5, 4.5, 17, 15, 1.6) + P("M7.5 4.5v15M16.5 4.5v15") + P("M5.5 8h.01M5.5 12h.01M5.5 16h.01M18.5 8h.01M18.5 12h.01M18.5 16h.01"),
      // An old television with an antenna.
      shows: R(3, 8, 18, 12.5, 2.5) + P("M8 3.5 12 8l4-4.5") + R(5.5, 10.5, 10, 7.5, 1.4) + P("M18.3 12.2h.01M18.3 15.2h.01"),
      // A striped popcorn box.
      kids: P("M6 10.5 7.6 20.5h8.8L18 10.5z") + P("M10 10.5l.5 10M14 10.5l-.5 10") + P("M6 10.5a2.3 2.3 0 0 1 1.6-4 2.6 2.6 0 0 1 4.4-1.8 2.6 2.6 0 0 1 4.4 1.8 2.3 2.3 0 0 1 1.6 4"),
      // A four-point sparkle and a small one.
      anime: P("M10.5 3.5c.7 4.3 2.2 5.8 6.5 6.5-4.3.7-5.8 2.2-6.5 6.5-.7-4.3-2.2-5.8-6.5-6.5 4.3-.7 5.8-2.2 6.5-6.5z") + P("M18 15v5M15.5 17.5h5"),
      // An open book with panels.
      manga: P("M3 5.5c3-.8 6-.5 9 1.5 3-2 6-2.3 9-1.5V19c-3-.8-6-.5-9 1.5-3-2-6-2.3-9-1.5z") + P("M12 7v13.5") + P("M5.8 9.5h3.4M14.8 9.5h3.4M5.8 13h3.4M14.8 13h3.4"),
      // An on-air lamp sending out waves.
      live: O(12, 12, 1.9) + P("M8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 8.2a5.4 5.4 0 0 1 0 7.6M5.3 5.3a9.5 9.5 0 0 0 0 13.4M18.7 5.3a9.5 9.5 0 0 1 0 13.4"),
      // Two admit-one tickets.
      vod: P("M5.5 8.8V6h13v2.8") + P("M3.5 9h17v3a1.6 1.6 0 0 0 0 3.2v3.3h-17v-3.3a1.6 1.6 0 0 0 0-3.2z") + P("M15 10.6v.9M15 13.3v.9M15 16v.9"),
      // A calendar page with a showtime clock.
      calendar: R(3.5, 5, 17, 15.5, 2) + P("M8 3v4M16 3v4M3.5 9.5h17") + O(12, 15, 3) + P("M12 13.6v1.5l1 .8"),
      // A stack of film cans.
      library: R(4.5, 16, 15, 4.5, 1.2) + R(5.5, 11, 13, 4, 1.2) + R(6.5, 6, 11, 4, 1.2) + P("M12 18.25h.01M12 13h.01M12 8h.01"),
      // An arrow down into a strip of film.
      downloads: P("M12 3.5v9.5M8.5 9.5 12 13l3.5-3.5") + R(3.5, 16, 17, 4.5, 1) + P("M6.5 18.25h1.5M11.25 18.25h1.5M16 18.25h1.5"),
      // A film cartridge: something you plug in.
      addons: R(4, 7, 16, 11, 2) + P("M9 7V4.5h6V7") + O(9, 12.5, 1.8) + O(15, 12.5, 1.8) + P("M10.8 12.5h2.4"),
      // A projector's dial with ticks.
      settings: O(12, 12, 5.5) + P("M12 12l2.6-2.6") + P("M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.46 5.46l1.41 1.41M17.13 17.13l1.41 1.41M5.46 18.54l1.41-1.41M17.13 6.87l1.41-1.41"),
    };
    const url = (svg) => `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
    const on = 'html[data-pj-icons="on"] aside[data-harbor-sidebar]';
    const views = Object.keys(ICONS);
    const all = views.map((v) => `[data-harbor-nav="${v}"]`).join(", ");
    let css =
      `${on} :is(${all}) > span:first-child { isolation: isolate; }\n` +
      `${on} :is(${all}) > span:first-child svg:not(.lucide-lock) { opacity: 0 !important; }\n` +
      `${on} :is(${all}) > span:first-child::before { content: ""; position: absolute; inset: 0; margin: auto; width: 24px; height: 24px; ` +
      `background: currentColor; -webkit-mask: var(--pj-icon) center / contain no-repeat; mask: var(--pj-icon) center / contain no-repeat; pointer-events: none; ` +
      `opacity: .82; transition: opacity .15s ease; }\n` +
      `${on} :is(${all}):hover > span:first-child::before { opacity: 1; }\n` +
      // The page you're on: the icon lights up in the accent with a soft lamp glow behind it.
      `${on} :is(${all})[data-active] > span:first-child::before { background: var(--color-accent); opacity: 1; }\n` +
      `${on} :is(${all})[data-active] > span:first-child::after { content: ""; position: absolute; inset: -9px; z-index: -1; border-radius: 50%; pointer-events: none; ` +
      `background: radial-gradient(closest-side, color-mix(in srgb, var(--color-accent) 26%, transparent), transparent); }\n`;
    for (const v of views) css += `${on} [data-harbor-nav="${v}"] > span:first-child { --pj-icon: ${url(S(ICONS[v]))}; }\n`;
    const iconStyle = el("style", { id: "projector-icons" });
    iconStyle.textContent = css;
    doc.head.append(iconStyle);
    hooks.apply.push(() => setAttr("pj-icons", state.icons ? "on" : "off"));
    hooks.dispose.push(() => iconStyle.remove());
  }

  /* ===== js/30-cinema.js: Cinema layer: light spill, focus pull, title reveal, house lights, accent from artwork, hover glow, rise-in, banner pointer tilt (milestone 2) =====
     Register work through hooks (see js/00-core.js). Remove everything you add in a hooks.dispose entry.

     How it stays cheap (plan section 5): everything costly is drawn once per banner slide into a small canvas and then
     only faded; only transform and opacity animate; the one rAF loop runs only while the pointer moves over the
     banner. A slide change is noticed by a MutationObserver on the banner's aria-hidden flags (fires once per change)
     plus the shared 1.5 s scan. Switches are html[data-pj-<key>] = on | off, written from hooks.apply, and already
     include the motion setting and Lite mode, so the CSS only has to check one attribute.
     Nodes Projector adds next to Harbor's own start with "projector-layer" (core CSS hides them while the player is
     mounted). Attributes put on React's elements (data-pj-reveal, data-pj-title, data-pj-pull, data-pj-tilt) are
     attributes React never sets, so it leaves them alone; they are all removed on unload. */
  {
    const LAYER = "projector-layer";
    const isOn = (k) => root.getAttribute("data-pj-" + k) === "on";
    // Set by the tools module (js/50-tools.js). Until it exists, treat it as Balanced.
    const perfMode = () => { const p = root.getAttribute("data-pj-perf"); return p === "full" || p === "lite" ? p : "balanced"; };
    const RISE_OK = !!(win.CSS && CSS.supports && CSS.supports("animation-timeline: view()"));
    const timers = new Set();
    const later = (ms, fn) => { const id = setTimeout(() => { timers.delete(id); fn(); }, ms); timers.add(id); return id; };
    const cancel = (id) => { if (id) { clearTimeout(id); timers.delete(id); } };

    /* ---------- reading artwork (ported from Fathom: analyse, sampleImage) ---------- */
    // The dominant colorful tone of a 32x20 copy: saturated, mid-light pixels weigh most; flat art falls back to the average.
    const TW = 32, TH = 20;
    function dominant(data) {
      let r = 0, g = 0, b = 0, w = 0, ar = 0, ag = 0, ab = 0, n = 0;
      for (let i = 0; i < data.length; i += 4) {
        const R = data[i], G = data[i + 1], B = data[i + 2];
        const max = Math.max(R, G, B), min = Math.min(R, G, B), l = (max + min) / 510, s = (max - min) / 255;
        const wt = s * s * Math.max(0.05, 1 - Math.abs(l - 0.5) * 1.7);
        r += R * wt; g += G * wt; b += B * wt; w += wt; ar += R; ag += G; ab += B; n++;
      }
      return w > 0.5 ? [r / w, g / w, b / w] : [ar / n, ag / n, ab / n];
    }
    // Pixels can only be read when the image host allows it (CORS). Harbor's own <img> tags don't ask for that, so a
    // separate copy is loaded with crossOrigin. When the host refuses, the result is null and callers fall back.
    const colorCache = new Map();
    function sampleImage(src) {
      if (!src) return Promise.resolve(null);
      if (colorCache.has(src)) return colorCache.get(src);
      const p = new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.decoding = "async";
        img.onload = () => {
          let out = null;
          try {
            const c = el("canvas"); c.width = TW; c.height = TH;
            const x = c.getContext("2d", { willReadFrequently: true });
            x.drawImage(img, 0, 0, TW, TH);
            out = dominant(x.getImageData(0, 0, TW, TH).data);
          } catch (e) { out = null; } // tainted: the host did not allow reading pixels
          resolve(out);
        };
        img.onerror = () => resolve(null);
        img.src = src;
      });
      if (colorCache.size > 200) colorCache.clear();
      colorCache.set(src, p);
      return p;
    }
    const tone = (rgb, s0, s1, l) => { const [h, s] = rgbToHsl(rgb); return hslToHex(h, clamp(s, s0, s1), l); };

    // Soft copies. Canvas filters where available, otherwise a tiny copy scaled up (same idea as the mockup).
    const CAN_FILTER = (() => { try { const x = el("canvas").getContext("2d"); x.filter = "blur(2px)"; return x.filter === "blur(2px)"; } catch (e) { return false; } })();
    function softDraw(x, src, dx, dy, dw, dh, blur, extra) {
      if (CAN_FILTER) { x.filter = `blur(${blur}px)${extra ? " " + extra : ""}`; x.drawImage(src, dx, dy, dw, dh); x.filter = "none"; return; }
      const t = el("canvas"); t.width = Math.max(4, Math.round(dw / blur)); t.height = Math.max(4, Math.round(dh / blur));
      t.getContext("2d").drawImage(src, 0, 0, t.width, t.height);
      x.imageSmoothingEnabled = true; x.imageSmoothingQuality = "high"; x.drawImage(t, dx, dy, dw, dh);
    }
    // Harbor's banner image is already loaded and decoded. Drawing it is fine even when its pixels can't be read:
    // the canvas only gets displayed, never read back.
    const ready = (img) => !!(img && img.complete && img.naturalWidth > 0);

    /* ---------- the banner as the cinema layer sees it ----------
       Harbor 0.9.113 (home.tsx, hero-carousel.tsx, hero.tsx): [data-scroll-anchor="hero"] > carousel viewport >
       track > one div per slide (aria-hidden="false" on the active one) > <section> with img.object-cover and the
       text block .max-w-2xl. Harbor keeps hidden pages mounted, so only a banner that is actually shown counts. */
    const shown = (n) => (n.checkVisibility ? n.checkVisibility({ visibilityProperty: true }) : n.getClientRects().length > 0);
    function heroNow() {
      const hero = doc.querySelector('[data-scroll-anchor="hero"]');
      if (!hero || !shown(hero)) return null;
      const slide = hero.querySelector('[aria-hidden="false"]') || hero;
      const img = slide.querySelector("img.object-cover");
      const track = slide !== hero ? slide.parentElement : null;
      const viewport = track && track.parentElement && hero.contains(track.parentElement) && track.parentElement !== hero ? track.parentElement : null;
      return {
        hero, slide, img, viewport,
        section: img ? img.parentElement : null,
        card: slide.querySelector(".max-w-2xl"),
        src: (img && (img.currentSrc || img.src)) || "",
      };
    }

    /* ---------- watching the banner ---------- */
    let cur = null, lastSlide = null, artSrc = "", artRgb = null, spillSrc = "", watched = null;
    const slideObs = new MutationObserver(() => { if (!disposed) check(); });
    function watch(hero) {
      if (watched === hero) return;
      slideObs.disconnect();
      unbindTilt();
      watched = hero;
      slideObs.observe(hero, { subtree: true, attributes: true, attributeFilter: ["aria-hidden"] });
      bindTilt(hero);
    }
    function check() {
      if (disposed || doc.hidden || doc.querySelector("[data-harbor-player]")) return;
      const info = heroNow();
      if (!info) return;
      cur = info;
      watch(info.hero);
      placeSpill(info.hero);
      placeBars(info.viewport);
      if (info.slide !== lastSlide) {
        lastSlide = info.slide;
        resetTilt();
        if (isOn("reveal")) reveal(info.card);
        if (isOn("focus") && ready(info.img)) pull(info);
        if (isOn("wide") && isOn("motion")) openBars();
      }
      if (info.src && ready(info.img)) {
        if (info.src !== artSrc) readArt(info);
        else if (isOn("spill") && perfMode() !== "lite" && spillSrc !== artSrc) drawSpill(info.img, artRgb);
      }
    }
    // Color first, then the spill drawn with it. Once per slide; sampleImage caches by address.
    function readArt(info) {
      const src = info.src;
      artSrc = src;
      sampleImage(src).then((rgb) => {
        if (disposed || artSrc !== src) return;
        const changed = !!rgb !== !!artRgb || (rgb && artRgb && rgb.some((v, i) => Math.abs(v - artRgb[i]) > 1));
        artRgb = rgb;
        if (isOn("spill") && perfMode() !== "lite" && info.img.isConnected) drawSpill(info.img, rgb);
        if (rgb && changed) setArtColor(rgb); // core: accent follows the artwork when that setting is on
      });
    }

    /* ---------- 1 + 2. light spill ----------
       The artwork's strongest color pooling below the banner, with a blurred small copy of the picture mixed in at
       the top (a blurred copy alone was nearly invisible: the bottom of most artwork is dark). Drawn once per slide
       into one of two 200x140 canvases, scaled up by CSS, and crossfaded by opacity. It sits inside the banner's
       anchor at z-index -1, so it paints behind the page's own content and scrolls with the banner. */
    const spill = el("div", { id: LAYER + "-spill", "aria-hidden": "true" });
    const spillCv = [el("canvas"), el("canvas")];
    spillCv.forEach((c) => { c.width = 200; c.height = 140; spill.append(c); });
    let spillFront = 0;
    function placeSpill(hero) {
      if (!isOn("spill") || perfMode() === "lite") { if (spill.isConnected) spill.remove(); return; }
      if (spill.parentElement !== hero) hero.append(spill);
    }
    function drawSpill(img, rgb) {
      if (!ready(img)) return;
      const c = spillCv[1 - spillFront], x = c.getContext("2d");
      x.clearRect(0, 0, 200, 140);
      if (rgb) {
        const col = hexToRgb(tone(rgb, 0.5, 0.9, 0.5)).join(" ");
        const g = x.createRadialGradient(100, 70, 4, 100, 74, 92);
        g.addColorStop(0, `rgb(${col} / .95)`); g.addColorStop(1, `rgb(${col} / 0)`);
        x.fillStyle = g; x.fillRect(0, 0, 200, 140);
      }
      x.globalAlpha = rgb ? 0.85 : 1;
      softDraw(x, img, 30, 6, 140, 60, 12, rgb ? "saturate(1.5)" : "saturate(1.7) brightness(1.25)");
      x.globalAlpha = 1;
      // Fade the edges out so the light has no shape.
      x.globalCompositeOperation = "destination-in";
      const m = x.createRadialGradient(100, 56, 8, 100, 64, 98);
      m.addColorStop(0, "rgb(0 0 0 / 1)"); m.addColorStop(0.55, "rgb(0 0 0 / .8)"); m.addColorStop(1, "rgb(0 0 0 / 0)");
      x.fillStyle = m; x.fillRect(0, 0, 200, 140);
      x.globalCompositeOperation = "source-over";
      c.setAttribute("data-on", "");
      spillCv[spillFront].removeAttribute("data-on");
      spillFront = 1 - spillFront;
      spillSrc = artSrc;
    }

    /* ---------- 3. focus pull ----------
       A soft 192px copy of the new slide sits right above Harbor's picture (under its shades and text) and fades out
       while the picture settles from a slight zoom. Drawn once, removed when done. No live CSS blur. */
    let pullNode = null, pullSection = null, pullTimer = 0;
    function clearPull() {
      cancel(pullTimer); pullTimer = 0;
      if (pullNode) { pullNode.remove(); pullNode = null; }
      if (pullSection) { pullSection.removeAttribute("data-pj-pull"); pullSection = null; }
    }
    function pull(info) {
      clearPull();
      const { img, section } = info;
      if (!section) return;
      const w = 192, h = Math.max(2, Math.round((w * img.naturalHeight) / img.naturalWidth));
      const c = el("canvas", { id: LAYER + "-pull", "aria-hidden": "true" });
      c.width = w; c.height = h;
      softDraw(c.getContext("2d"), img, -6, -6, w + 12, h + 12, 5);
      // Same box as the picture (Harbor insets it 2px with rounded corners).
      const cs = getComputedStyle(img);
      c.style.cssText = `left:${img.offsetLeft}px;top:${img.offsetTop}px;width:${img.offsetWidth}px;height:${img.offsetHeight}px;border-radius:${cs.borderRadius}`;
      img.after(c);
      section.setAttribute("data-pj-pull", "");
      pullNode = c; pullSection = section;
      pullTimer = later(1400, clearPull);
    }

    /* ---------- 4. title reveal ----------
       React owns the title (an h1/h2 or a logo image) and its text, so nothing is rewritten. The text block's
       children rise in: the title first, then the rest. Two identical keyframe sets (a/b) restart the animation on
       each slide without forcing a layout. The title's wrapper is marked once so CSS can give it the bigger move. */
    function reveal(card) {
      if (!card) return;
      const title = card.querySelector("h1, h2") || card.querySelector('img[alt]:not([alt=""])');
      if (title) {
        let wrap = title;
        while (wrap.parentElement && wrap.parentElement !== card) wrap = wrap.parentElement;
        if (wrap.parentElement === card && !wrap.hasAttribute("data-pj-title")) wrap.setAttribute("data-pj-title", "");
      }
      card.setAttribute("data-pj-reveal", card.getAttribute("data-pj-reveal") === "a" ? "b" : "a");
    }

    /* ---------- 5. house lights ----------
       a) Dim behind Harbor's hover preview: pure CSS on the preview's own full-screen layer (css/30-cinema.css,
          Fragile), so it appears and goes exactly with the preview and costs nothing when it isn't there.
       b) A quick fade to black when a Play button is pressed. Its own fixed layer, removed the moment
          [data-harbor-player] mounts (hooks.player, and core CSS hides projector-layer* while the player is up),
          with a hard timeout so it can never stay up. Play buttons are found by Harbor's lucide play icon, which
          works in every language. The banner's Play opens the detail page, so it doesn't count. */
    const lights = el("div", { id: LAYER + "-lights", "aria-hidden": "true" });
    let lightsTimer = 0;
    const PLAY_ICON = "svg.lucide-play, svg.lucide-circle-play, svg.lucide-play-circle";
    function lightsOff(fade) {
      cancel(lightsTimer); lightsTimer = 0;
      if (!lights.isConnected) return;
      if (!fade) { lights.remove(); lights.removeAttribute("data-state"); return; }
      lights.setAttribute("data-state", "lift");
      lightsTimer = later(320, () => lightsOff(false));
    }
    function fadeToBlack() {
      cancel(lightsTimer);
      lights.setAttribute("data-state", "black");
      if (!lights.isConnected) doc.body.append(lights);
      // Harbor shows the play picker first when it has to ask, so the lights come back up if no player arrives.
      lightsTimer = later(1500, () => lightsOff(true));
    }
    listen(doc, "click", (e) => {
      if (!isOn("lights") || !isOn("motion") || e.button !== 0) return;
      const b = e.target && e.target.closest ? e.target.closest('button, [role="button"]') : null;
      if (!b || !b.querySelector(PLAY_ICON)) return;
      if (b.closest('[data-scroll-anchor="hero"], [data-harbor-player], [id^="projector"]')) return;
      if (doc.querySelector("[data-harbor-player]")) return;
      fadeToBlack();
    }, true);

    /* ---------- 6. hover glow ----------
       Harbor already lifts the poster on hover (pick-card.tsx: translate and scale on [data-preview-anchor]), so the
       lift stays Harbor's. Projector adds a glow layer behind the poster, painted once as a radial gradient in the
       poster's own color and only faded (CSS). The color is read once per poster, a moment after the pointer arrives,
       and Harbor's hover ring takes the same color. */
    /* Poster light (like YouTube's ambient mode): behind the poster you point at, a blurred, saturated copy of the
       poster itself spills past its edges, so each title lights the row in its own colors. Two small canvases are
       reused (the last one can still fade out while the next fades in); each is drawn once per poster at a quarter
       of its size and only faded by CSS. Drawing Harbor's decoded image works even when its pixels can't be read,
       because the canvas is never read back. The same light sits behind Harbor's hover preview card. */
    const AMB_T = 16, AMB_S = 22, AMB_B = 40, AMB_K = 0.25, PREV_PAD = 44;
    const ambPool = [0, 1].map(() => el("canvas", { class: "pj-amb", "aria-hidden": "true" }));
    const prevAmb = el("canvas", { class: "pj-amb-prev", "aria-hidden": "true" });
    let ambNext = 0, prevTimers = [];
    function paintAmb(c, img, w, h, ix, iy, iw, ih, blur) {
      const src = img.currentSrc || img.src;
      const key = `${src}|${w}x${h}`;
      if (c.dataset.key === key) return;
      c.width = Math.max(8, Math.round(w * AMB_K)); c.height = Math.max(8, Math.round(h * AMB_K));
      const x = c.getContext("2d");
      x.clearRect(0, 0, c.width, c.height);
      try { softDraw(x, img, ix * AMB_K, iy * AMB_K, iw * AMB_K, ih * AMB_K, blur, "saturate(1.9) brightness(1.2)"); }
      catch (e) { return; }
      c.dataset.key = key;
    }
    /* Which card the pointer or focus is on. Posters use Harbor's [data-preview-anchor]. The wide cards (Harbor 1.0.3
       continue-card.tsx, home/new-episodes-section.tsx, collection-card.tsx) have no anchor, so they are found by
       their own markup and get the same light, shaped to the wide card. The collection card clips its contents, so
       its light goes just before it in its parent (same offset parent) instead of inside it. Fragile selectors. */
    const WIDE = "[data-continue-card-trigger], div.group.relative.shrink-0 > button.overflow-hidden, button.group\\/card";
    function cardAt(t) {
      if (!t || !t.closest) return null;
      const host = t.closest("[data-preview-anchor]");
      if (host) return { host, card: host.parentElement, wide: false };
      let w = null;
      try { w = t.closest(WIDE); } catch (e) { return null; } // a bad selector must never take Harbor down
      if (!w || !w.parentElement) return null;
      return { host: w, card: w.parentElement, wide: true, sibling: w.tagName === "BUTTON" && w.classList.contains("group/card") };
    }
    let litCanvas = null;
    function lightPoster(t) {
      if (litCanvas) { litCanvas.removeAttribute("data-on"); litCanvas = null; }
      if (!t || !isOn("glow")) return;
      const { host, card, wide, sibling } = t;
      const img = host.querySelector(".harbor-poster img") || host.querySelector("img");
      if (!card || !ready(img) || !host.offsetWidth) return;
      let c = card.querySelector(":scope > canvas.pj-amb");
      if (c && sibling && c.nextElementSibling !== host) c = null;
      if (!c) { c = ambPool[ambNext]; ambNext ^= 1; if (sibling) card.insertBefore(c, host); else card.append(c); }
      if (wide) c.setAttribute("data-wide", sibling ? "sib" : "in"); else c.removeAttribute("data-wide");
      if (wide) { c.setAttribute("data-on", ""); litCanvas = c; }
      const pw = host.offsetWidth, ph = host.offsetHeight, w = pw + AMB_S * 2, h = ph + AMB_T + AMB_B;
      Object.assign(c.style, { left: host.offsetLeft - AMB_S + "px", top: host.offsetTop - AMB_T + "px", width: w + "px", height: h + "px" });
      // The copy is a little larger than the poster and dropped a few px, so the light pools underneath.
      paintAmb(c, img, w, h, AMB_S - pw * 0.04, AMB_T + 6 - ph * 0.03, pw * 1.08, ph * 1.06, 6);
    }
    // Harbor's hover preview opens a moment after the pointer settles. A few cheap checks find its card and put the
    // same light behind it (its frame is keyed per open, so a new frame gets the canvas again).
    function lightPreview(host) {
      const panel = doc.querySelector("div.pointer-events-none.fixed.inset-0 [role=presentation].group.relative.overflow-hidden");
      const frame = panel && panel.parentElement;
      if (!frame || !panel.offsetWidth) return false;
      const img = [panel.querySelector("img"), host && host.querySelector("img")].find(ready);
      if (!img) return false;
      const w = panel.offsetWidth + PREV_PAD * 2, h = panel.offsetHeight + PREV_PAD * 2;
      if (prevAmb.parentElement !== frame) frame.prepend(prevAmb);
      // The card's edge light and title rule take the poster's color too.
      const g = host && host.style.getPropertyValue("--pj-glow");
      if (g) frame.style.setProperty("--pj-glow", g);
      Object.assign(prevAmb.style, { left: -PREV_PAD + "px", top: -PREV_PAD + "px", width: w + "px", height: h + "px" });
      paintAmb(prevAmb, img, w, h, PREV_PAD, PREV_PAD + 10, panel.offsetWidth, panel.offsetHeight, 9);
      return true;
    }
    function watchPreview(host) {
      prevTimers.forEach(cancel);
      prevTimers = [500, 900, 1400, 2200].map((ms) => later(ms, () => { if (!disposed && isOn("glow")) lightPreview(host); }));
    }

    let glowHost = null, glowTimer = 0;
    const glowSrc = new WeakMap();
    function onPoster(t) {
      const host = t ? t.host : null;
      if (host === glowHost) return;
      glowHost = host;
      cancel(glowTimer); glowTimer = 0;
      if (!host || !isOn("glow")) { lightPoster(null); return; }
      lightPoster(t);
      if (t.wide) return;
      watchPreview(host);
      glowTimer = later(90, () => {
        const img = host.querySelector("img");
        const src = img && (img.currentSrc || img.src);
        if (!src || glowSrc.get(host) === src) return;
        sampleImage(src).then((rgb) => {
          if (!rgb || disposed || !host.isConnected) return;
          glowSrc.set(host, src);
          host.style.setProperty("--pj-glow", tone(rgb, 0.45, 0.9, 0.56));
        });
      });
    }
    // Hover grace: the pointer skimming a card's edge (or Harbor's own lift moving the card under it) must never
    // flash the light. Leaving waits 160 ms and moving to another card 70 ms; coming back inside that time cancels it.
    let hoverTimer = 0;
    function wantPoster(t) {
      cancel(hoverTimer); hoverTimer = 0;
      const host = t ? t.host : null;
      if (host === glowHost) return;
      hoverTimer = later(host ? (glowHost ? 70 : 0) : 160, () => { hoverTimer = 0; onPoster(t); });
    }
    listen(doc, "pointerover", (e) => {
      if (e.pointerType === "touch") return;
      wantPoster(cardAt(e.target));
    }, { passive: true });
    listen(doc, "mouseout", (e) => { if (!e.relatedTarget) wantPoster(null); }, { passive: true });
    listen(doc, "focusin", (e) => {
      const t = e.target;
      if (!t || !t.matches || !t.matches(":focus-visible")) return;
      const card = t.closest("button.group");
      const host = card && card.querySelector("[data-preview-anchor]");
      onPoster(host ? { host, card, wide: false } : cardAt(t));
    });

    /* ---------- 7. rise-in on scroll: CSS only (scroll-driven animations), see css/30-cinema.css ---------- */

    /* ---------- 8. banner pointer tilt (ported from Fathom's moveHero / resetHero) ----------
       The carousel frame tilts toward the pointer (up to 2.4 degrees), the picture shifts the other way (16px) and
       the text drifts a little with it. Transforms only, written at most once a frame and only while a mouse or pen
       moves over the banner; CSS transitions smooth it and ease it back on leave. Nothing runs while the pointer is
       still. The frame is tilted rather than the anchor, so the light spill (inside the anchor) stays put. */
    let tiltHero = null, tiltRaf = 0, tiltEv = null, tilted = null;
    function onTiltMove(e) {
      if (e.pointerType === "touch" || !isOn("parallax")) return;
      tiltEv = e;
      if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltFrame);
    }
    function tiltFrame() {
      tiltRaf = 0;
      const e = tiltEv, info = cur;
      if (!e || disposed || !info || !info.viewport || info.hero !== tiltHero || !isOn("parallax")) return;
      const r = info.hero.getBoundingClientRect(); // the anchor itself is never transformed, so this is stable
      if (!r.width || !r.height) return;
      const px = clamp(((e.clientX - r.left) / r.width) * 2 - 1, -1, 1), py = clamp(((e.clientY - r.top) / r.height) * 2 - 1, -1, 1);
      if (tilted && tilted.slide !== info.slide) resetTilt();
      const parts = tilted || { slide: info.slide, frame: info.viewport, img: info.img, card: info.card };
      const shift = `translate3d(${(-px * 16).toFixed(1)}px, ${(-py * 10).toFixed(1)}px, 0) scale(1.06)`;
      parts.frame.setAttribute("data-pj-tilt", "frame");
      parts.frame.style.transform = `perspective(1600px) rotateX(${(-py * 1.6).toFixed(2)}deg) rotateY(${(px * 2.4).toFixed(2)}deg)`;
      if (parts.img) { parts.img.setAttribute("data-pj-tilt", "art"); parts.img.style.transform = shift; }
      if (pullNode && pullSection && pullSection.contains(pullNode) && parts.img && pullSection === parts.img.parentElement) {
        pullNode.style.transform = shift; // the soft copy moves with the picture it covers
      }
      if (parts.card) { parts.card.setAttribute("data-pj-tilt", "copy"); parts.card.style.transform = `translate3d(${(px * 6).toFixed(1)}px, ${(py * 4).toFixed(1)}px, 0)`; }
      tilted = parts;
    }
    function resetTilt() {
      if (tiltRaf) { cancelAnimationFrame(tiltRaf); tiltRaf = 0; }
      tiltEv = null;
      if (!tilted) return;
      for (const n of [tilted.frame, tilted.img, tilted.card]) if (n) n.style.removeProperty("transform");
      tilted = null;
    }
    function bindTilt(hero) {
      tiltHero = hero;
      hero.addEventListener("pointermove", onTiltMove, { passive: true });
      hero.addEventListener("pointerleave", resetTilt);
    }
    function unbindTilt() {
      resetTilt();
      if (!tiltHero) return;
      tiltHero.removeEventListener("pointermove", onTiltMove, { passive: true });
      tiltHero.removeEventListener("pointerleave", resetTilt);
      tiltHero = null;
    }

    /* ---------- 9. widescreen bars and grain ---------- */
    // Bars: two black halves inside the carousel frame that open on each slide (CSS sets the 2.39:1 crop).
    const bars = el("div", { id: LAYER + "-bars", "aria-hidden": "true" });
    bars.innerHTML = "<i></i><i></i>";
    function placeBars(viewport) {
      if (!isOn("wide") || !viewport) { if (bars.isConnected) bars.remove(); return; }
      if (bars.parentElement !== viewport) viewport.append(bars);
    }
    function openBars() { bars.setAttribute("data-run", bars.getAttribute("data-run") === "a" ? "b" : "a"); }
    // Grain: one 160px noise tile drawn once, moved by a stepped transform about 10 times a second (CSS).
    let grain = null;
    function syncGrain() {
      if (state.grain && !grain) {
        const c = el("canvas"); c.width = c.height = 160;
        const x = c.getContext("2d"), d = x.createImageData(160, 160);
        for (let i = 0; i < d.data.length; i += 4) { const v = Math.random() * 255; d.data[i] = d.data[i + 1] = d.data[i + 2] = v; d.data[i + 3] = 255; }
        x.putImageData(d, 0, 0);
        grain = el("div", { id: LAYER + "-grain", "aria-hidden": "true" });
        grain.style.backgroundImage = `url(${c.toDataURL()})`;
        doc.body.append(grain);
      } else if (!state.grain && grain) { grain.remove(); grain = null; }
    }

    /* ---------- switches ---------- */
    let pending = 0;
    hooks.apply.push(() => {
      const motion = motionOn(), lite = perfMode() === "lite";
      const flag = (k, v) => setAttr("pj-" + k, v ? "on" : "off");
      flag("spill", state.spill && !lite);
      flag("focus", state.focus && motion);
      flag("reveal", state.reveal && motion);
      flag("lights", state.lights);
      flag("glow", state.glow && !lite);
      flag("rise", state.rise && motion && !lite && RISE_OK);
      flag("parallax", state.parallax && motion);
      flag("wide", state.wide);
      flag("grain", state.grain);
      syncGrain();
      if (!isOn("parallax")) resetTilt();
      if (!isOn("focus")) clearPull();
      if (!isOn("lights")) lightsOff(false);
      // Layers that were switched on (or off) catch up right away instead of waiting for the next scan.
      if (!pending) pending = later(0, () => { pending = 0; check(); });
    });
    hooks.scan.push(check);
    hooks.player.push((on) => { if (on) { lightsOff(false); resetTilt(); clearPull(); } });
    listen(doc, "visibilitychange", () => { if (doc.hidden) resetTilt(); });

    /* ---------- cleanup ---------- */
    hooks.dispose.push(() => {
      slideObs.disconnect();
      unbindTilt();
      clearPull();
      timers.forEach((id) => clearTimeout(id)); timers.clear();
      [spill, bars, lights].forEach((n) => n.remove());
      if (grain) { grain.remove(); grain = null; }
      spillCv.forEach((c) => { c.width = c.height = 0; });
      doc.querySelectorAll("[data-pj-reveal]").forEach((n) => n.removeAttribute("data-pj-reveal"));
      doc.querySelectorAll("[data-pj-title]").forEach((n) => n.removeAttribute("data-pj-title"));
      doc.querySelectorAll("[data-pj-pull]").forEach((n) => n.removeAttribute("data-pj-pull"));
      doc.querySelectorAll("[data-pj-tilt]").forEach((n) => { n.removeAttribute("data-pj-tilt"); n.style.removeProperty("transform"); });
      doc.querySelectorAll("[data-preview-anchor]").forEach((n) => n.style.removeProperty("--pj-glow"));
      prevTimers.forEach(cancel);
      if (prevAmb.parentElement) prevAmb.parentElement.style.removeProperty("--pj-glow");
      [...ambPool, prevAmb].forEach((c) => { c.removeAttribute("data-on"); c.removeAttribute("data-wide"); c.remove(); c.width = c.height = 0; delete c.dataset.key; });
      colorCache.clear();
      cancel(hoverTimer);
      cur = lastSlide = watched = glowHost = null;
    });
  }

  /* ===== js/40-features.js: Harbor features: hover preview, Intermission (screensaver), spoilers, numerals, badges, focus ring (milestone 3) =====
     Register work through hooks (see js/00-core.js). Remove everything you add in a hooks.dispose entry.
     Most of milestone 3 is CSS only (css/40-features.css): a restyle of Harbor's own markup. The one script piece is
     below: Harbor's hover preview grows out of the card it belongs to. */
  {
    /* ---------- hover preview grows from its card ----------
       Harbor mounts its preview as a fixed z-[110] layer straight inside #root, centred over the card. When one
       appears, the panel starts at the card's size and place (same centre, scaled to the card's width, tipped back
       a few degrees, transparent) and grows into its own size and place: one WAAPI transform/opacity animation,
       above Harbor's own CSS scale-in. Harbor still owns opening, placement, content, its staggered rows and closing.
       Watched with a childList-only observer on #root, so it costs nothing while no preview opens. */
    let lastAnchor = null, rootObs = null, watchedRoot = null;
    const PANEL = '[role="presentation"]';
    const isLayer = (n) => n.nodeType === 1 && n.classList.contains("fixed") && n.classList.contains("inset-0") && n.classList.contains("z-[110]");

    listen(doc, "pointerover", (e) => {
      const a = e.target && e.target.closest && e.target.closest("[data-preview-anchor]");
      if (a) lastAnchor = a;
    }, { passive: true });
    listen(doc, "focusin", (e) => {
      const a = e.target && e.target.querySelector && e.target.querySelector("[data-preview-anchor]");
      if (a) lastAnchor = a;
    });

    function grow(layer) {
      if (root.getAttribute("data-pj-grow") !== "on" || !lastAnchor || !lastAnchor.isConnected) return;
      const panel = layer.querySelector(PANEL);
      if (!panel || !panel.animate) return;
      const p = panel.getBoundingClientRect(), c = lastAnchor.getBoundingClientRect();
      if (!p.width || !c.width || c.bottom < 0 || c.top > innerHeight) return;
      const dx = (c.left + c.width / 2) - (p.left + p.width / 2);
      const dy = (c.top + c.height / 2) - (p.top + p.height / 2);
      // Start just covering the card, so the window reads as coming out of it.
      const s = Math.max(0.3, Math.min(1, Math.max(c.width / p.width, c.height / p.height)));
      panel.setAttribute("data-pj-grown", "");
      panel.animate([
        { transformOrigin: "50% 50%", transform: `perspective(1000px) translate3d(${dx}px, ${dy}px, 0) scale(${s}) rotateX(12deg)`, opacity: 0 },
        { transformOrigin: "50% 50%", opacity: 1, offset: 0.3 },
        { transformOrigin: "50% 50%", transform: "perspective(1000px) translate3d(0, 0, 0) scale(1) rotateX(0deg)", opacity: 1 },
      ], { duration: 560, easing: "cubic-bezier(.4, .1, .2, 1.04)" });
    }
    function onRoot(muts) {
      for (const m of muts) for (const n of m.addedNodes) {
        // Read the size and place a frame later, once Harbor has positioned the panel, still before it is painted.
        if (isLayer(n)) requestAnimationFrame(() => { if (!disposed && n.isConnected) grow(n); });
      }
    }
    function watchRoot() {
      const r = doc.getElementById("root");
      if (r === watchedRoot) return;
      if (rootObs) rootObs.disconnect();
      watchedRoot = r;
      if (!r) return;
      rootObs = rootObs || new MutationObserver(onRoot);
      rootObs.observe(r, { childList: true });
    }

    hooks.apply.push(() => setAttr("pj-grow", state.grow && motionOn() ? "on" : "off"));
    hooks.scan.push(watchRoot);
    hooks.dispose.push(() => { if (rootObs) rootObs.disconnect(); rootObs = watchedRoot = lastAnchor = null; });
  }

  /* ===== js/50-tools.js: Tools: command palette, shortcut sheet, settings panel, first-run welcome, settings code, performance mode (milestone 4) =====
     Everything here sits in one block so its names stay local; it uses core's state, set(), STOCKS, TYPES, DEFAULTS,
     hooks, el(), listen(), store and setAttr(). Keys (none collide with Harbor 0.9.113 lib/hotkeys.ts, whose global
     keys are "/", Ctrl+=, Ctrl+- and Ctrl+0, and whose player keys only apply while the player is up, when these are off):
       Ctrl+K  command palette        Alt+T  settings panel        ?  shortcut sheet        Esc  close the top one
     All of it steps aside while Harbor's player is mounted or html[data-chrome-hidden] is set. */
  {
    const SEEN_KEY = "projector.seen.v1";   // first-run welcome shown
    const AUTO_KEY = "projector.auto.v1";   // Auto performance: the level it settled on, and whether Full ever failed
    const CODE_PREFIX = "PROJECTOR1:";
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const svg = (d) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${d}</svg>`;
    const ICON = {
      customize: svg('<path d="M4 7.5h9M17 7.5h3M4 16.5h3M11 16.5h9"/><circle cx="15" cy="7.5" r="2"/><circle cx="9" cy="16.5" r="2"/>'),
      close: svg('<path d="M6 6l12 12M18 6L6 18"/>'),
    };
    const PAGES = [["home", "Home"], ["discover", "Discover"], ["movies", "Movies"], ["shows", "Shows"], ["anime", "Anime"], ["live", "Live TV"], ["calendar", "Calendar"], ["library", "Library"], ["settings", "Harbor settings"]];
    const APPEARANCE = [["dark", "Dark"], ["light", "Light"], ["time", "Time of day"], ["windows", "Windows"]];
    const APPEARANCE_LONG = { dark: "Dark", light: "Light", time: "Follow time of day", windows: "Follow Windows" };
    const MOTION = [["on", "On"], ["off", "Off"], ["system", "Follow Windows"]];
    const PERF = [["auto", "Auto"], ["balanced", "Balanced"], ["lite", "Lite"]];
    const STOCK_NOTES = {
      neutral: "True grays. Artwork as it is.",
      warm: "Brown-black and paper-white ink, a touch of amber.",
      cool: "Blue-gray shadows and slightly cooler artwork.",
      mono: "Grayscale chrome. Only the artwork has color.",
      faded: "Lifted blacks and soft contrast, like an old print.",
    };
    const TYPE_NOTES = {
      premiere: "Bodoni Moda with Schibsted Grotesk. A high-contrast serif, like a festival poster.",
      paperback: "Brygada 1918 with Albert Sans. A warmer book serif, easy on long reads.",
      titlecard: "Archivo throughout: condensed and heavy for titles, normal width for text.",
      harbor: "The fonts chosen in Harbor's own settings.",
    };
    // [setting, name, what it does, paused in Lite]
    const CINEMA = [
      ["icons", "Projector icons", "Film-themed icons in the sidebar. Off brings back Harbor's own.", false],
      ["spill", "Light spill", "The banner's colors glow onto the page around it.", true],
      ["parallax", "Banner follows the pointer", "The banner tilts toward the pointer and the picture shifts the other way. Only while the pointer is over it.", false],
      ["focus", "Focus pull", "Each new banner starts soft and sharpens.", false],
      ["reveal", "Title reveal", "Banner titles rise in word by word.", false],
      ["lights", "House lights", "The page dims behind the hover preview and fades to black before playback.", false],
      ["leak", "Light leak", "A warm sweep of light when you change pages, like film running through a gate.", true],
      ["grow", "Preview grows from the card", "Harbor's hover preview, with the summary and details, grows out of the card you point at instead of popping up on its own.", true],
      ["glow", "Poster light", "The poster you point at lights the row in its own colors, and Harbor's hover preview card too.", true],
      ["curtain", "Scene fade", "Each new page clears in from a soft dim, like a gentle cut between scenes.", false],
      ["brand", "Streaming tile glow", "Your Streaming tiles light up in each service's own color when you point at them.", false],
      ["bulbs", "Marquee bulbs", "Continue Watching progress shows as a row of lit marquee bulbs.", false],
      ["beam", "Projector beam", "A soft cone of light falls across the poster you point at.", false],
      ["rise", "Rise in on scroll", "Rows rise and fade in as they scroll into view.", true],
      ["wide", "Widescreen banner", "A wide cinema crop with bars that open on each slide.", false],
      ["grain", "Film grain", "A fine moving grain over everything.", false],
    ];
    const PERF_NOTES = {
      full: "Every effect, including the ones that only run in Full.",
      balanced: "Every everyday effect. The default.",
      lite: "Light spill, hover glow, rise-in and the light leak are off.",
    };
    const hourText = (h) => `${Math.floor(h)}:${String(Math.round((h % 1) * 60)).padStart(2, "0")}`;
    const isEditable = (t) => !!t && t.nodeType === 1 && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || /^(textbox|searchbox|combobox)$/.test(t.getAttribute("role") || ""));
    const visible = (n) => !!n && n.getClientRects().length > 0;
    const focusables = (box) => [...box.querySelectorAll('button, input, [tabindex]')].filter((n) => !n.disabled && n.tabIndex >= 0 && visible(n));
    const focusSoft = (n) => { if (n && n.isConnected && n.focus) n.focus({ preventScroll: true }); };
    let playerUp = false;
    const blocked = () => playerUp || root.hasAttribute("data-chrome-hidden");
    const timers = new Set();
    const later = (ms, fn) => { const id = setTimeout(() => { timers.delete(id); fn(); }, ms); timers.add(id); return id; };
    const cancel = (id) => { clearTimeout(id); timers.delete(id); };

    /* ---------- performance mode ----------
       html[data-pj-perf] = full | balanced | lite. Balanced and Lite are fixed choices; Auto starts at Balanced and moves
       by measuring frames, but only while you scroll or move the pointer (a requestAnimationFrame loop that stops 1.2 s
       after the last input). Ported from Fathom with its safeguards: readings right after a change are ignored, stepping
       down takes two slow readings in a row, stepping up takes four smooth ones and two quiet minutes after any step
       down, and once Full has failed Auto doesn't try it again until you ask. Nothing is decided while Harbor hides its
       chrome (player, Settings). */
    let auto = { level: "balanced", fullFailed: false };
    try {
      const a = JSON.parse(store.get(AUTO_KEY) || "null");
      if (a && ["full", "balanced", "lite"].includes(a.level)) auto = { level: a.level, fullFailed: !!a.fullFailed };
    } catch (e) { /* keep the defaults */ }
    const saveAuto = () => store.set(AUTO_KEY, JSON.stringify(auto));
    const perfLevel = () => (state.perf === "auto" ? auto.level : state.perf);
    const perf = { frames: [], slow: 0, smooth: 0, fps: 0, drop: -1, readings: 0 };
    let sampRaf = 0, sampLast = 0, sampUntil = 0, autoChangedAt = -1e9, autoDroppedAt = -1e9;
    const measuring = () => !disposed && !doc.hidden && !blocked() && (state.perf === "auto" || (panelOpen() && panelTab === "speed"));
    function sampleTick(t) {
      if (sampLast) { const d = t - sampLast; if (d < 250) perf.frames.push(d); } // longer gaps are a hidden tab or a pause, not a frame
      sampLast = t;
      if (perf.frames.length >= 240) evaluatePerf();
      if (t < sampUntil && measuring()) sampRaf = requestAnimationFrame(sampleTick);
      else { sampRaf = 0; sampLast = 0; }
    }
    function noteActivity() {
      if (sampRaf) { sampUntil = performance.now() + 1200; return; }
      if (!measuring()) return;
      sampUntil = performance.now() + 1200;
      sampRaf = requestAnimationFrame(sampleTick);
    }
    function evaluatePerf() {
      const d = perf.frames.splice(0).sort((p, q) => p - q);
      if (!d.length) return;
      // The fastest typical frame is the display's refresh interval. Capped at 17.5 ms (57 Hz) so a page that is slow on
      // every frame still counts as slow; Fathom's version read a steady 30 fps as smooth.
      const vsync = Math.min(d[Math.floor(d.length * 0.1)] || 16.7, 17.5);
      const median = d[Math.floor(d.length / 2)] || vsync;
      perf.fps = Math.round(1000 / median);
      perf.drop = d.filter((v) => v > vsync * 1.9).length / d.length;
      perf.readings++;
      const now = performance.now();
      if (state.perf === "auto" && !blocked() && now - autoChangedAt > 3000) {
        const before = auto.level;
        perf.slow = perf.drop > 0.12 ? perf.slow + 1 : 0;
        perf.smooth = perf.drop < 0.02 ? perf.smooth + 1 : 0;
        if (perf.slow >= 2 && auto.level !== "lite") {
          if (auto.level === "full") auto.fullFailed = true;
          auto.level = auto.level === "full" ? "balanced" : "lite";
          autoDroppedAt = now;
        } else if (now - autoDroppedAt > 120000 && perf.smooth >= 4 && (auto.level === "lite" || (auto.level === "balanced" && !auto.fullFailed))) {
          auto.level = auto.level === "lite" ? "balanced" : "full";
        }
        if (auto.level !== before) {
          autoChangedAt = now;
          perf.slow = 0; perf.smooth = 0;
          saveAuto();
          apply();
          if (auto.level === "lite") toast("Projector switched to Lite to keep Harbor smooth.");
        }
      }
      refreshStat();
    }
    const statText = () => (perf.drop < 0 ? "Scroll or move the pointer to measure" : `${perf.fps} fps, ${Math.round(perf.drop * 100)}% slow frames`);
    listen(win, "pointermove", noteActivity, { passive: true });
    listen(win, "wheel", noteActivity, { passive: true });
    listen(win, "scroll", noteActivity, { capture: true, passive: true });
    // First in line: the cinema layer (js/30-cinema.js, which registers earlier) reads data-pj-perf in its own apply hook.
    hooks.apply.unshift(() => setAttr("pj-perf", perfLevel()));

    /* ---------- toast ---------- */
    const toastEl = el("p", { id: "projector-toast", role: "status", "aria-live": "polite" });
    let toastTimer = 0;
    function toast(msg) {
      toastEl.textContent = msg;
      toastEl.classList.add("pjt-show");
      cancel(toastTimer);
      toastTimer = later(2800, () => toastEl.classList.remove("pjt-show"));
    }

    /* ---------- settings code ---------- */
    const b64 = (s) => btoa(Array.from(new TextEncoder().encode(s), (b) => String.fromCharCode(b)).join(""));
    const unb64 = (s) => new TextDecoder().decode(Uint8Array.from(atob(s), (c) => c.charCodeAt(0)));
    function encode() {
      const o = {};
      for (const k in DEFAULTS) o[k] = state[k];
      return CODE_PREFIX + b64(JSON.stringify(o));
    }
    // Returns a full settings object (unknown keys dropped, missing ones at their defaults); set() validates each value.
    function decode(code) {
      const raw = String(code).replace(/\s+/g, "");
      const body = raw.startsWith(CODE_PREFIX) ? raw.slice(CODE_PREFIX.length) : raw;
      const obj = JSON.parse(unb64(body));
      if (!obj || typeof obj !== "object" || Array.isArray(obj)) throw new Error("not a settings object");
      const out = Object.assign({}, DEFAULTS);
      for (const k in DEFAULTS) if (k !== "schema" && Object.prototype.hasOwnProperty.call(obj, k)) out[k] = obj[k];
      return out;
    }
    function copyCode(done) {
      const code = encode();
      const ok = () => done(true, code), fail = () => done(false, code);
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(code).then(ok, fail);
      else fail();
    }

    /* ---------- Customize button in Harbor's sidebar footer ----------
       Harbor (chrome/sidebar.tsx, 0.9.113) unmounts the sidebar on Settings and during playback, so the button is put
       back on every scan. It goes in the footer (the aside's last div) above the profile chip, never between React's
       own nav items. In the 72px icon column only its icon shows (css/50-tools.css). */
    const cust = el("button", { type: "button", id: "projector-customize", "aria-label": "Customize Projector", title: "Customize theme (Alt T)", "aria-haspopup": "dialog", "aria-expanded": "false", "aria-keyshortcuts": "Alt+T" });
    cust.innerHTML = `${ICON.customize}<span class="pjt-cust-label">Customize theme</span><kbd aria-hidden="true">Alt T</kbd>`;
    cust.addEventListener("click", () => togglePanel(cust));
    function placeCustomize() {
      const aside = doc.querySelector("aside[data-harbor-sidebar]");
      const foot = aside && (aside.querySelector(":scope > [data-harbor-sidebar-footer]") || aside.lastElementChild);
      if (!foot || foot.tagName !== "DIV" || foot.id) return;
      const anchor = [...foot.children].filter((c) => c !== cust).pop() || null;
      if (cust.parentNode !== foot || cust.nextElementSibling !== anchor) foot.insertBefore(cust, anchor);
    }

    /* ---------- command palette ---------- */
    const pal = el("div", { id: "projector-palette", class: "pjt-scrim", hidden: "" });
    pal.innerHTML =
      `<div class="pjt-pal" role="dialog" aria-modal="true" aria-label="Projector commands">` +
      `<input class="pjt-pal-input" type="text" role="combobox" aria-expanded="true" aria-controls="projector-palette-list" aria-autocomplete="list" aria-label="Type a command or page" placeholder="Type a command or page" autocomplete="off" spellcheck="false">` +
      `<div class="pjt-pal-list" id="projector-palette-list" role="listbox" aria-label="Commands"></div>` +
      `<p class="pjt-pal-empty" role="status" hidden></p>` +
      `<p class="pjt-pal-foot" aria-hidden="true"><span><kbd>Up</kbd> <kbd>Down</kbd> choose</span><span><kbd>Enter</kbd> run</span><span><kbd>Esc</kbd> close</span></p></div>`;
    const palInput = pal.querySelector(".pjt-pal-input"), palList = pal.querySelector(".pjt-pal-list"), palEmpty = pal.querySelector(".pjt-pal-empty");
    let palItems = [], palActive = 0, palOpener = null;

    function go(id) {
      const h = win.harbor;
      if (h && typeof h.navigate === "function") h.navigate(id);
      else { const b = doc.querySelector(`[data-harbor-nav="${id}"]`); if (b) b.click(); }
    }
    // Harbor's own search. window.harbor.search() opens it (App.tsx, 0.9.113); older builds only have the "/" key, so
    // the fallback sends that key the way Harbor's SearchHotkey listens for it (keydown on window, not from a text field).
    function openSearch() {
      const h = win.harbor;
      if (h && typeof h.search === "function") { h.search(); return; }
      win.dispatchEvent(new KeyboardEvent("keydown", { key: "/", code: "Slash", bubbles: true, cancelable: true }));
    }
    /* Harbor's hover preview card is Harbor's own setting (Settings, Library & metadata, Cards, Hover preview) and a
       theme can't change Harbor's settings. Harbor 1.0.3's window.harbor.openSettings() takes no section, so this
       opens Settings and types "Hover preview" into Harbor's settings search, then presses Enter to jump to it. If
       any step isn't there (another Harbor version), Settings still opens and the toast gives the path. */
    function openHoverSetting() {
      const h = win.harbor || {};
      if (typeof h.openSettings === "function") h.openSettings();
      else if (typeof h.navigate === "function") h.navigate("settings");
      toast("Settings: Library & metadata, Cards, Hover preview. Pick Default or Marquee.");
      let tries = 0;
      const find = () => {
        const input = doc.querySelector("[data-settings-search-field] input");
        if (!input) { if (++tries < 15) later(100, find); return; }
        const setter = Object.getOwnPropertyDescriptor(win.HTMLInputElement.prototype, "value").set;
        setter.call(input, "Hover preview");
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.focus();
        later(120, () => input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", code: "Enter", bubbles: true, cancelable: true })));
      };
      later(150, find);
    }
    function change(patch, msg) { set(patch); if (msg) toast(msg); }
    function commands() {
      const cur = doc.querySelector("[data-harbor-nav][data-active]");
      const curId = cur && cur.getAttribute("data-harbor-nav");
      const list = [];
      const add = (group, label, run, opt) => list.push(Object.assign({ group, label, run, words: "" }, opt));
      PAGES.forEach(([id, name]) => add("Go to", name, () => go(id), { state: curId === id ? "Current" : "", words: "page open" }));
      add("Go to", "Search Harbor", openSearch, { key: "/", words: "find title movie show" });
      add("Projector", "Customize Projector", () => openPanel(), { key: "Alt T", words: "settings panel options" });
      add("Projector", "Keyboard shortcuts", () => openKeys(), { key: "?", words: "keys help hotkeys" });
      add("Projector", "Turn on Harbor's hover preview", openHoverSetting, { words: "pop up popup card peek pip hover preview settings" });
      add("Projector", "Copy settings code", () => copyCode((ok) => (ok ? toast("Settings code copied.") : openPanel(null, "speed", true))), { words: "backup export share" });
      APPEARANCE.forEach(([v]) => add("Appearance", APPEARANCE_LONG[v], () => change({ appearance: v }, "Appearance: " + APPEARANCE_LONG[v]), { state: state.appearance === v ? "Current" : "", words: "theme mode scheme" }));
      Object.keys(STOCKS).forEach((k) => add("Film stock", STOCKS[k].name, () => change({ stock: k }, "Film stock: " + STOCKS[k].name), { state: state.stock === k ? "Current" : "", words: "colors palette" }));
      Object.keys(TYPES).forEach((k) => add("Type", TYPES[k].name, () => change({ type: k }, "Type: " + TYPES[k].name), { state: state.type === k ? "Current" : "", words: "font fonts typeface" }));
      add("Accent", "Accent from the artwork", () => change({ accent: "artwork" }, "Accent from the artwork"), { state: state.accent === "artwork" ? "Current" : "", words: "color" });
      add("Accent", "Film stock's own accent", () => change({ accent: "stock" }, "Accent from the film stock"), { state: state.accent === "stock" ? "Current" : "", words: "color fixed" });
      MOTION.forEach(([v, name]) => add("Motion", "Animations: " + name, () => change({ motion: v }, "Animations: " + name), { state: state.motion === v ? "Current" : "", words: "motion animation reduce" }));
      CINEMA.forEach(([k, name]) => add("Cinema", name, () => change({ [k]: !state[k] }, `${name} ${state[k] ? "off" : "on"}`), { state: state[k] ? "On" : "Off", words: "turn toggle effect on off" }));
      PERF.forEach(([v, name]) => add("Speed", "Performance: " + name, () => change({ perf: v }, "Performance: " + name), { state: state.perf === v ? "Current" : "", words: "performance speed mode" }));
      return list;
    }
    function renderPalette() {
      const q = palInput.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const all = commands().map((c, i) => Object.assign(c, { order: i }));
      let items = all.filter((c) => { const hay = `${c.group} ${c.label} ${c.words}`.toLowerCase(); return q.every((w) => hay.includes(w)); });
      if (q.length) {
        // Groups whose labels start with what you typed come first; order inside a group stays as listed.
        const score = (c) => { const l = c.label.toLowerCase(); return l.startsWith(q[0]) ? 0 : l.includes(q[0]) ? 1 : 2; };
        const best = {};
        items.forEach((c) => { best[c.group] = Math.min(best[c.group] == null ? 9 : best[c.group], score(c)); });
        items = items.sort((a, b) => best[a.group] - best[b.group] || a.order - b.order);
      }
      palItems = items;
      palActive = Math.min(palActive, Math.max(0, items.length - 1));
      palEmpty.hidden = items.length > 0;
      palEmpty.textContent = items.length ? "" : `Nothing matches "${palInput.value.trim()}". Try a page, a film stock or "dark".`;
      let html = "", last = null, g = 0;
      items.forEach((c, i) => {
        if (c.group !== last) {
          if (last !== null) html += "</div>";
          html += `<div role="group" aria-labelledby="projector-pg-${g}"><div class="pjt-pal-group" id="projector-pg-${g}" role="presentation">${esc(c.group)}</div>`;
          last = c.group; g++;
        }
        const tail = c.state ? `<span class="pjt-pal-state${c.state === "On" || c.state === "Current" ? " pjt-on" : ""}">${c.state}</span>` : c.key ? `<kbd>${esc(c.key)}</kbd>` : "";
        html += `<div class="pjt-pal-item" role="option" id="projector-po-${i}" data-i="${i}" aria-selected="${i === palActive}"><span class="pjt-pal-label">${esc(c.label)}</span>${tail}</div>`;
      });
      if (last !== null) html += "</div>";
      palList.innerHTML = html;
      palList.hidden = !items.length;
      setPalActive(palActive);
    }
    function setPalActive(i) {
      const prev = palList.querySelector('[aria-selected="true"]');
      if (prev) prev.setAttribute("aria-selected", "false");
      palActive = i;
      const n = palList.querySelector(`#projector-po-${i}`);
      if (!n) { palInput.removeAttribute("aria-activedescendant"); return; }
      n.setAttribute("aria-selected", "true");
      palInput.setAttribute("aria-activedescendant", n.id);
      n.scrollIntoView({ block: "nearest" });
    }
    const palOpen = () => !pal.hidden;
    function openPalette() {
      if (palOpen() || blocked()) return;
      palOpener = keysOpen() ? keysOpener : doc.activeElement;
      if (keysOpen()) closeKeys(false);
      pal.hidden = false;
      palInput.value = "";
      palActive = 0;
      renderPalette();
      palList.scrollTop = 0;
      palInput.focus({ preventScroll: true });
    }
    function closePalette(restore) {
      if (!palOpen()) return;
      pal.hidden = true;
      if (restore !== false) focusSoft(palOpener);
    }
    function runCommand(i) {
      const c = palItems[i];
      if (!c) return;
      closePalette(true); // focus goes back first, so whatever the command opens takes it from there
      try { c.run(); } catch (e) { console.warn("[projector]", e); }
    }
    palInput.addEventListener("input", () => { palActive = 0; renderPalette(); });
    palInput.addEventListener("keydown", (e) => {
      const n = palItems.length;
      if (e.key === "ArrowDown" && n) { e.preventDefault(); setPalActive((palActive + 1) % n); }
      else if (e.key === "ArrowUp" && n) { e.preventDefault(); setPalActive((palActive - 1 + n) % n); }
      else if ((e.key === "PageDown" || e.key === "PageUp") && n) { e.preventDefault(); setPalActive(Math.max(0, Math.min(n - 1, palActive + (e.key === "PageDown" ? 6 : -6)))); }
      else if (e.key === "Enter") { e.preventDefault(); runCommand(palActive); }
    });
    // Only a real pointer move changes the highlight, so the list scrolling under a still pointer doesn't.
    palList.addEventListener("pointermove", (e) => { const o = e.target.closest("[data-i]"); if (o && +o.dataset.i !== palActive) setPalActive(+o.dataset.i); });
    palList.addEventListener("click", (e) => { const o = e.target.closest("[data-i]"); if (o) runCommand(+o.dataset.i); });
    pal.addEventListener("pointerdown", (e) => { if (e.target === pal) { e.preventDefault(); closePalette(true); } });

    /* ---------- shortcut sheet ---------- */
    const keys = el("div", { id: "projector-keys", class: "pjt-scrim", hidden: "" });
    keys.innerHTML =
      `<div class="pjt-sheet" role="dialog" aria-modal="true" aria-labelledby="projector-keys-title">` +
      `<div class="pjt-sheet-head"><h2 id="projector-keys-title">Projector's keys</h2><button type="button" class="pjt-x" data-close aria-label="Close the shortcut list">${ICON.close}</button></div>` +
      `<dl class="pjt-keylist">` +
      `<dt><kbd>Ctrl</kbd> <kbd>K</kbd></dt><dd>Open or close the command palette</dd>` +
      `<dt><kbd>Alt</kbd> <kbd>T</kbd></dt><dd>Open or close Projector's settings</dd>` +
      `<dt><kbd>?</kbd></dt><dd>Show this list</dd>` +
      `<dt><kbd>Esc</kbd></dt><dd>Close what Projector opened</dd>` +
      `<dt><kbd>Up</kbd> <kbd>Down</kbd> <kbd>Enter</kbd></dt><dd>Choose and run a command in the palette</dd>` +
      `<dt><kbd>Left</kbd> <kbd>Right</kbd></dt><dd>Move between tabs and options in the settings</dd>` +
      `</dl><p class="pjt-hint">Harbor's own keys, like <kbd>/</kbd> for search, are listed in Harbor's settings.</p></div>`;
    let keysOpener = null;
    const keysOpen = () => !keys.hidden;
    function openKeys() {
      if (keysOpen() || blocked()) return;
      keysOpener = palOpen() ? palOpener : doc.activeElement;
      if (palOpen()) closePalette(false);
      keys.hidden = false;
      focusSoft(keys.querySelector("[data-close]"));
    }
    function closeKeys(restore) {
      if (!keysOpen()) return;
      keys.hidden = true;
      if (restore !== false) focusSoft(keysOpener);
    }
    keys.addEventListener("click", (e) => { if (e.target === keys || e.target.closest("[data-close]")) closeKeys(true); });

    /* ---------- settings panel ----------
       A solid side sheet (no blur) with four tabs. Each tab is built once when shown; after that refresh() only updates
       states in place, so focus stays where it is while settings change the page live. */
    const TABS = [["look", "Look"], ["cinema", "Cinema"], ["motion", "Motion"], ["speed", "Speed and backup"]];
    const panel = el("div", { id: "projector-panel", role: "dialog", "aria-modal": "true", "aria-labelledby": "projector-panel-title", hidden: "" });
    panel.innerHTML =
      `<header class="pjt-ph"><h2 id="projector-panel-title">Projector</h2><button type="button" class="pjt-x" data-close aria-label="Close Projector settings">${ICON.close}</button></header>` +
      `<div class="pjt-tabs" role="tablist" aria-label="Settings sections">${TABS.map(([id, name]) =>
        `<button type="button" role="tab" id="projector-tab-${id}" data-tab="${id}" aria-controls="projector-panel-body" aria-selected="false" tabindex="-1">${name}</button>`).join("")}</div>` +
      `<div class="pjt-pbody" id="projector-panel-body" role="tabpanel"></div>` +
      `<p class="pjt-pfoot"><span><kbd>Alt</kbd> <kbd>T</kbd> settings</span><span><kbd>Ctrl</kbd> <kbd>K</kbd> commands</span><span><kbd>?</kbd> all keys</span></p>`;
    const pbody = panel.querySelector(".pjt-pbody");
    let panelTab = "look", panelOpener = null, closeTimer = 0, codeMsg = "", resetUndo = null, sampleFonts = null;
    const panelOpen = () => !panel.hidden;

    const C = {
      label: (id, text) => `<div class="pjt-label" id="projector-l-${id}">${text}</div>`,
      seg: (k, label, opts) => `<div class="pjt-field">${C.label(k, label)}<div class="pjt-seg" role="radiogroup" aria-labelledby="projector-l-${k}">${opts.map(([v, l]) =>
        `<button type="button" role="radio" data-k="${k}" data-v="${v}">${l}</button>`).join("")}</div>`,
      hint: (text, attrs) => `<p class="pjt-hint"${attrs || ""}>${text}</p>`,
      range: (k, label, min, max) => `<label class="pjt-range"><span>${label}</span><output data-out="${k}"></output>` +
        `<input type="range" data-range="${k}" min="${min}" max="${max}" step="0.25"></label>`,
    };
    const TAB_HTML = {
      look() {
        const harborFont = root.style.getPropertyValue("--font-display").trim() || "system-ui, sans-serif";
        return C.seg("appearance", "Appearance", APPEARANCE) + `</div>` +
          `<div class="pjt-timeset" data-show="time">` +
          C.range("dawn", "Light from", 3, 11) + C.range("dusk", "Dark from", 15, 23) +
          C.hint("", ' data-out="time-now"') + `</div>` +
          C.hint("", ' data-out="windows-now" data-show="windows"') +
          `<div class="pjt-field">${C.label("stock", "Film stock")}<div class="pjt-cards" role="radiogroup" aria-labelledby="projector-l-stock">${Object.keys(STOCKS).map((k) =>
            `<button type="button" role="radio" class="pjt-card pjt-stock" data-k="stock" data-v="${k}" aria-describedby="projector-sd-${k}">` +
            `<span class="pjt-chips" aria-hidden="true"><i></i><i></i><i></i><i></i></span>` +
            `<span><b>${esc(STOCKS[k].name)}</b><small id="projector-sd-${k}">${STOCK_NOTES[k] || ""}</small></span></button>`).join("")}</div></div>` +
          C.seg("accent", "Accent", [["artwork", "From the artwork"], ["stock", "Film stock's own"]]) +
          C.hint("Mono keeps its own accent, so the artwork doesn't tint it.", ' data-show="mono"') + `</div>` +
          `<div class="pjt-field">${C.label("type", "Type")}<div class="pjt-cards" role="radiogroup" aria-labelledby="projector-l-type">${Object.keys(TYPES).map((k) => {
            const t = TYPES[k], fam = t.display || harborFont;
            return `<button type="button" role="radio" class="pjt-card pjt-type" data-k="type" data-v="${k}" aria-describedby="projector-td-${k}">` +
              `<span class="pjt-type-sample" aria-hidden="true" style="font-family:${esc(fam)};font-weight:${t.weight};font-stretch:${t.stretch};letter-spacing:${t.track}">Tonight's feature</span>` +
              `<b>${esc(t.name)}</b><small id="projector-td-${k}">${TYPE_NOTES[k] || ""}</small></button>`;
          }).join("")}</div></div>` +
          C.seg("navStyle", "Navigation", [["marquee", "Marquee"], ["icons", "Icons"]]) + `</div>` +
          C.seg("navPos", "Navigation sits", [["left", "Left"], ["top", "Top"], ["bottom", "Bottom"]]) + `</div>` +
          C.hint("Marquee shows page names, Icons shows only icons. It is Harbor's own sidebar setting, so Harbor's collapse button changes it too. In a window narrower than 1024px Harbor always shows icons.");
      },
      cinema() {
        return C.hint("Lite performance mode is on, so light spill, poster light, rise-in and the light leak are paused.", ' data-show="lite"') +
          C.hint("Animations are off, so the moving effects are paused. Change it under Motion.", ' data-show="still"') +
          `<div class="pjt-field pjt-harbor">${C.label("hoverprev", "Hover preview card")}` +
          C.hint("The pop-up card that opens when you rest on a poster is Harbor's own, and it is off until you turn it on: Settings, Library &amp; metadata, Cards, Hover preview (style Default or Marquee). Projector styles it and lights it in the poster's colors.") +
          `<div class="pjt-btns"><button type="button" class="pjt-btn" data-do="hover-setting">Open Harbor's hover preview setting</button></div></div>` +
          `<div class="pjt-toggles">${CINEMA.map(([k, name, desc]) =>
            `<button type="button" role="switch" class="pjt-tog" data-k="${k}" aria-labelledby="projector-t-${k}" aria-describedby="projector-td2-${k}">` +
            `<span class="pjt-tog-text"><b id="projector-t-${k}">${name}</b><small id="projector-td2-${k}">${desc}</small></span><i class="pjt-switch" aria-hidden="true"></i></button>`).join("")}</div>`;
      },
      motion() {
        return C.seg("motion", "Animations", MOTION) + `</div>` +
          C.hint("", ' data-out="motion-now"') +
          C.hint("Projector only moves things when you act or scroll. Nothing runs while the page is still.");
      },
      speed() {
        return C.seg("perf", "Performance", PERF) + `</div>` +
          C.hint("", ' data-out="perf-now"') +
          `<div class="pjt-stat"><span>While browsing</span><b data-out="stat"></b></div>` +
          `<div class="pjt-btns" data-show="retry"><button type="button" class="pjt-btn" data-do="retry-full">Try Full again</button></div>` +
          `<div class="pjt-field">${C.label("code", "Settings code")}` +
          C.hint("Copy your setup to move it to another computer or share it.") +
          `<div class="pjt-btns"><button type="button" class="pjt-btn pjt-primary" data-do="copy">Copy settings code</button></div>` +
          `<input class="pjt-text" type="text" data-code aria-labelledby="projector-l-code" placeholder="Paste a settings code" spellcheck="false" autocomplete="off">` +
          `<div class="pjt-btns"><button type="button" class="pjt-btn" data-do="import">Apply code</button></div></div>` +
          `<div class="pjt-field">${C.label("reset", "Reset")}` +
          `<div class="pjt-btns"><button type="button" class="pjt-btn pjt-danger" data-do="reset">Reset everything</button></div></div>` +
          `<div class="pjt-status" role="status" data-out="code-msg"></div>` +
          C.hint(`Projector ${esc(VERSION)}.`);
      },
    };

    function renderTab() {
      pbody.innerHTML = TAB_HTML[panelTab]();
      pbody.setAttribute("aria-labelledby", "projector-tab-" + panelTab);
      if (panelTab === "look" && !sampleFonts) {
        // The type samples need every pairing's fonts. Loaded the first time the Look tab is shown, never before.
        const fams = Object.keys(TYPES).map((k) => TYPES[k].family).filter(Boolean).join("&family=");
        sampleFonts = el("link", { rel: "stylesheet", id: "projector-fonts-samples", href: `https://fonts.googleapis.com/css2?family=${fams}&display=swap` });
        doc.head.append(sampleFonts);
      }
      refresh();
    }
    function selectTab(id, focus) {
      panelTab = id;
      panel.querySelectorAll("[role=tab]").forEach((b) => {
        const on = b.dataset.tab === id;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      pbody.scrollTop = 0;
      renderTab();
      if (id === "speed") noteActivity();
    }
    const showIf = (key, on) => pbody.querySelectorAll(`[data-show="${key}"]`).forEach((n) => { n.hidden = !on; });
    const out = (key, text) => { const n = pbody.querySelector(`[data-out="${key}"]`); if (n && n.textContent !== text) n.textContent = text; };
    function refreshStat() { if (panelOpen() && panelTab === "speed") out("stat", statText()); }
    function refresh() {
      if (!panelOpen()) return;
      cust.setAttribute("aria-expanded", "true");
      const light = root.getAttribute("data-pj-scheme") === "light";
      state.navStyle = navStyleNow(); // read live from Harbor's sidebar; dropped again by normalize() on save
      pbody.querySelectorAll("[role=radiogroup]").forEach((g) => {
        const radios = [...g.querySelectorAll("[role=radio]")];
        let any = false;
        radios.forEach((b) => { const on = String(state[b.dataset.k]) === b.dataset.v; any = any || on; b.setAttribute("aria-checked", String(on)); b.tabIndex = on ? 0 : -1; });
        if (!any && radios[0]) radios[0].tabIndex = 0;
      });
      pbody.querySelectorAll("[role=switch]").forEach((b) => b.setAttribute("aria-checked", String(!!state[b.dataset.k])));
      pbody.querySelectorAll("[data-range]").forEach((r) => {
        const k = r.dataset.range;
        if (+r.value !== state[k]) r.value = state[k];
        r.setAttribute("aria-valuetext", hourText(state[k]));
        out(k, hourText(state[k]));
      });
      pbody.querySelectorAll(".pjt-stock").forEach((b) => {
        const t = STOCKS[b.dataset.v][light ? "light" : "dark"];
        [t.canvas, t.raised, t.ink, t.accent].forEach((c, i) => { b.querySelectorAll("i")[i].style.background = c; });
      });
      const lvl = perfLevel();
      showIf("time", state.appearance === "time");
      showIf("windows", state.appearance === "windows");
      showIf("mono", !!STOCKS[state.stock].fixedAccent && state.accent === "artwork");
      showIf("lite", lvl === "lite");
      showIf("still", root.getAttribute("data-pj-motion") === "off");
      showIf("retry", state.perf === "auto" && (auto.level !== "full" || auto.fullFailed));
      out("time-now", `Right now: ${light ? "light" : "dark"}. Light from ${hourText(state.dawn)}, dark from ${hourText(state.dusk)}, warmer toward each change.`);
      out("windows-now", `Windows is set to ${light ? "light" : "dark"} right now.`);
      const sys = state.motion === "system";
      out("motion-now", `Right now: ${root.getAttribute("data-pj-motion") === "off" ? "off" : "on"}${sys ? (root.getAttribute("data-pj-motion") === "off" ? ", because Windows asks for less motion." : ", following Windows.") : "."}`);
      out("perf-now", state.perf === "auto"
        ? `Auto measures frames only while you scroll or move the pointer. It starts at Balanced, moves up to Full after a run of smooth readings, and steps down if Harbor stutters. Right now: ${lvl[0].toUpperCase() + lvl.slice(1)}. ${PERF_NOTES[lvl]}`
        : PERF_NOTES[lvl]);
      out("stat", statText());
      const msg = pbody.querySelector('[data-out="code-msg"]');
      if (msg && msg.dataset.msg !== codeMsg + (resetUndo ? "|u" : "")) {
        msg.dataset.msg = codeMsg + (resetUndo ? "|u" : "");
        msg.innerHTML = codeMsg ? `<span>${esc(codeMsg)}</span>${resetUndo ? ' <button type="button" class="pjt-link" data-do="undo">Undo</button>' : ""}` : "";
      }
    }
    hooks.apply.push(refresh);

    function openPanel(from, tab, selectCode) {
      if (blocked()) return;
      cancel(closeTimer);
      if (!store.get(SEEN_KEY)) store.set(SEEN_KEY, "1");
      const wasOpen = panel.classList.contains("pjt-open");
      if (!wasOpen) panelOpener = palOpen() ? palOpener : keysOpen() ? keysOpener : from || doc.activeElement;
      closePalette(false);
      closeKeys(false);
      if (tab) panelTab = tab;
      if (!wasOpen) {
        panel.hidden = false;
        void panel.offsetWidth; // start the slide from off screen
        panel.classList.add("pjt-open");
      }
      selectTab(panelTab, true);
      if (selectCode) {
        codeMsg = "Copying was blocked. The code is in the box above and selected; copy it with Ctrl+C.";
        refresh();
        const inp = pbody.querySelector("[data-code]");
        if (inp) { inp.value = encode(); inp.focus(); inp.select(); }
      }
    }
    function closePanel(restore) {
      if (!panelOpen() || !panel.classList.contains("pjt-open")) return;
      panel.classList.remove("pjt-open");
      cust.setAttribute("aria-expanded", "false");
      codeMsg = ""; resetUndo = null;
      const done = () => { panel.hidden = true; pbody.innerHTML = ""; welcome.remove(); };
      if (root.getAttribute("data-pj-motion") === "off") done(); else closeTimer = later(280, done);
      if (restore !== false) focusSoft(panelOpener && panelOpener.isConnected ? panelOpener : cust);
    }
    const togglePanel = (from) => (panelOpen() && panel.classList.contains("pjt-open") ? closePanel(true) : openPanel(from));

    panel.addEventListener("click", (e) => {
      const b = e.target.closest("button");
      if (!b) return;
      if (b.hasAttribute("data-close")) return closePanel(true);
      if (b.dataset.tab) return selectTab(b.dataset.tab);
      const k = b.dataset.k;
      if (k === "navStyle") { setNavStyle(b.dataset.v); later(60, refresh); return; }
      if (k && b.getAttribute("role") === "radio") { if (String(state[k]) !== b.dataset.v) set({ [k]: b.dataset.v }); return; }
      if (k && b.getAttribute("role") === "switch") { set({ [k]: !state[k] }); return; }
      const act = b.dataset.do;
      if (act === "hover-setting") {
        closePanel(false);
        openHoverSetting();
      } else if (act === "retry-full") {
        auto = { level: "full", fullFailed: false }; saveAuto();
        perf.slow = 0; perf.smooth = 0; autoChangedAt = performance.now();
        apply();
        toast("Trying Full. Auto steps down again if Harbor stutters.");
      } else if (act === "copy") {
        copyCode((ok, code) => {
          resetUndo = null;
          if (ok) { codeMsg = "Copied. Paste it into Projector on the other computer."; refresh(); return; }
          codeMsg = "Copying was blocked. The code is in the box above and selected; copy it with Ctrl+C.";
          refresh();
          const inp = pbody.querySelector("[data-code]");
          if (inp) { inp.value = code; inp.focus(); inp.select(); }
        });
      } else if (act === "import") {
        const inp = pbody.querySelector("[data-code]");
        resetUndo = null;
        try {
          if (!inp.value.trim()) throw new Error("empty");
          set(decode(inp.value));
          codeMsg = "Settings applied.";
          inp.value = "";
        } catch (err) { codeMsg = "That isn't a Projector settings code. Copy it again and paste the whole thing."; }
        refresh();
      } else if (act === "reset") {
        resetUndo = Object.assign({}, state);
        auto = { level: "balanced", fullFailed: false }; saveAuto();
        perf.slow = 0; perf.smooth = 0;
        codeMsg = "Everything is back to the defaults.";
        set(Object.assign({}, DEFAULTS));
      } else if (act === "undo" && resetUndo) {
        const prev = resetUndo;
        resetUndo = null;
        codeMsg = "Your settings are back.";
        set(prev);
        focusSoft(pbody.querySelector('[data-do="reset"]'));
      }
    });
    panel.addEventListener("input", (e) => {
      const r = e.target.closest("[data-range]");
      if (r) set({ [r.dataset.range]: +r.value });
    });
    panel.addEventListener("keydown", (e) => {
      const t = e.target;
      const dir = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      const tab = t.closest && t.closest("[role=tab]");
      if (tab && (dir || e.key === "Home" || e.key === "End")) {
        e.preventDefault();
        const i = TABS.findIndex(([id]) => id === tab.dataset.tab);
        const n = e.key === "Home" ? 0 : e.key === "End" ? TABS.length - 1 : (i + dir + TABS.length) % TABS.length;
        selectTab(TABS[n][0], true);
        return;
      }
      const radio = t.closest && t.closest("[role=radio]");
      if (radio && dir) {
        e.preventDefault();
        const radios = [...radio.closest("[role=radiogroup]").querySelectorAll("[role=radio]")];
        const next = radios[(radios.indexOf(radio) + dir + radios.length) % radios.length];
        next.click();
        next.focus();
      }
    });

    /* ---------- first run ----------
       The first time Projector is applied, the settings panel opens by itself on Look once the page has settled, with
       a short welcome line at the top. It counts as seen as soon as it opens (or the panel is opened any other way),
       so it never comes back; after that the panel is behind Customize theme in the sidebar and Alt T. */
    const startedAt = performance.now();
    const welcome = el("div", { class: "pjt-welcome", id: "projector-welcome" });
    welcome.innerHTML = `<p><b>Projector is on.</b> Make it yours: pick a film stock, type and how much moves. Every change shows live. ` +
      `You can come back any time with <b>Customize theme</b> at the bottom of the sidebar, or <kbd>Alt</kbd> <kbd>T</kbd>.</p>`;
    // Applying the theme happens in Harbor's Settings (its search field is on screen then). Each time, the panel
    // opens once you are back on a page with the sidebar. A plain app launch only does this the very first time.
    let armed = !store.get(SEEN_KEY) || !!doc.querySelector("[data-settings-search-field]");
    function firstRun() {
      if (disposed || !armed || blocked() || !cust.isConnected || panelOpen()) return;
      armed = false;
      panel.querySelector(".pjt-ph").after(welcome);
      openPanel(cust, "look");
    }

    /* ---------- keys ---------- */
    const topLayer = () => (palOpen() ? pal : keysOpen() ? keys : panelOpen() && panel.classList.contains("pjt-open") ? panel : null);
    function trapTab(e, box) {
      if (box === pal) { e.preventDefault(); palInput.focus(); return; }
      const f = focusables(box);
      if (!f.length) return;
      const i = f.indexOf(doc.activeElement);
      if (i === -1) { e.preventDefault(); f[e.shiftKey ? f.length - 1 : 0].focus(); }
      else if (e.shiftKey && i === 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
    // Capture phase on window: runs before Harbor's own window and document listeners, so a key Projector uses
    // (Esc closing the palette, say) doesn't also go back a page in Harbor.
    listen(win, "keydown", (e) => {
      if (disposed || e.isComposing || e.key === "Process") return;
      const top = topLayer();
      if (e.key === "Escape") {
        if (!top) return;
        e.preventDefault(); e.stopPropagation();
        if (top === pal) closePalette(true); else if (top === keys) closeKeys(true); else closePanel(true);
        return;
      }
      if (blocked()) return;
      const t = e.target, mod = e.ctrlKey || e.metaKey;
      const inText = t && t.nodeType === 1 && (t.tagName === "TEXTAREA" || t.isContentEditable);
      if (mod && !e.altKey && !e.shiftKey && (e.code === "KeyK" || e.key === "k" || e.key === "K")) {
        if (inText || e.repeat) return;
        e.preventDefault(); e.stopPropagation();
        if (palOpen()) closePalette(true); else openPalette();
        return;
      }
      if (e.altKey && !mod && !e.shiftKey && (e.code === "KeyT" || e.key === "t" || e.key === "T")) {
        if (inText || e.repeat) return;
        e.preventDefault(); e.stopPropagation();
        togglePanel();
        return;
      }
      if (e.key === "?" && !mod && !e.altKey) {
        if (isEditable(t) || e.repeat) return;
        e.preventDefault(); e.stopPropagation();
        if (keysOpen()) closeKeys(true); else openKeys();
        return;
      }
      if (e.key === "Tab" && top) trapTab(e, top);
    }, true);
    // Keys typed inside Projector's own layers stay there: Harbor's arrow-key navigation and modal handlers listen on
    // window and document, and would otherwise move focus out of the palette or panel.
    [pal, keys, panel].forEach((n) => n.addEventListener("keydown", (e) => e.stopPropagation()));

    /* ---------- Harbor's player and hidden chrome ---------- */
    function stepAside() {
      closePalette(false);
      closeKeys(false);
      closePanel(false);
      cancelAnimationFrame(sampRaf); sampRaf = 0; sampLast = 0; perf.frames.length = 0;
    }
    hooks.player.push((on) => { playerUp = on; if (on) stepAside(); });
    const hideObserver = new MutationObserver(() => { if (root.hasAttribute("data-chrome-hidden")) stepAside(); });
    hideObserver.observe(root, { attributes: true, attributeFilter: ["data-chrome-hidden"] });

    /* ---------- start, scan, cleanup ---------- */
    doc.body.append(pal, keys, panel, toastEl);
    hooks.scan.push(() => {
      placeCustomize();
      if (armed && performance.now() - startedAt > 900) firstRun();
    });
    if (armed) later(1000, () => { placeCustomize(); firstRun(); });
    hooks.dispose.push(() => {
      hideObserver.disconnect();
      cancelAnimationFrame(sampRaf);
      timers.forEach((id) => clearTimeout(id)); timers.clear();
      [pal, keys, panel, toastEl, cust, welcome, sampleFonts].forEach((n) => n && n.remove());
    });

    // Test hook for the bench: __projector.tools. Attached after start-up (js/90-start.js creates __projector), and
    // removed with it on unload.
    Promise.resolve().then(() => {
      if (disposed || !win.__projector) return;
      win.__projector.tools = {
        openPalette, closePalette, openKeys, closeKeys, openPanel, closePanel, encode, decode,
        get perf() { return { level: perfLevel(), auto: Object.assign({}, auto), fps: perf.fps, drop: perf.drop, slow: perf.slow, smooth: perf.smooth, readings: perf.readings, sampling: !!sampRaf }; },
        // Feeds frame durations (ms) straight into the evaluator, as if measured while scrolling.
        feedFrames(list) { perf.frames.push(...list); evaluatePerf(); return this.perf; },
        // Skips Auto's waiting times (3 s after a change, 2 min after a step down) for testing.
        skipWaits() { autoChangedAt = -1e9; autoDroppedAt = -1e9; },
        resetFirstRun() { armed = true; try { localStorage.removeItem(SEEN_KEY); } catch (e) { /* blocked */ } },
        firstRun,
      };
    });
  }

  /* ===== js/70-signature.js: signature switches and the light leak between pages =====
     The beam, sprockets, flicker, title cards, playbill and showtimes are CSS only (css/70-signature.css). This file
     sets their switches and runs the light leak: when Harbor marks a different sidebar button active (the page
     changed, whichever way it was reached), one warm band sweeps across the window. Noticed by a MutationObserver on
     the sidebar's data-active flags, which fires only on page changes; the layer exists only for the 0.8 s sweep. */
  {
    const leak = el("div", { id: "projector-layer-leak", "aria-hidden": "true" });
    const curtain = el("div", { id: "projector-layer-curtain", "aria-hidden": "true" });
    let curtainTimer = 0;
    let leakTimer = 0, lastView = null, watchedAside = null;
    const activeView = () => {
      const b = doc.querySelector("aside[data-harbor-sidebar] [data-harbor-nav][data-active]");
      return b ? b.getAttribute("data-harbor-nav") : null;
    };
    function part() {
      if (root.getAttribute("data-pj-curtain") !== "on" || doc.hidden || doc.querySelector("[data-harbor-player]")) return;
      if (!curtain.isConnected) doc.body.append(curtain);
      curtain.setAttribute("data-run", curtain.getAttribute("data-run") === "a" ? "b" : "a");
      clearTimeout(curtainTimer);
      curtainTimer = setTimeout(() => { curtain.remove(); curtain.removeAttribute("data-run"); }, 560);
    }
    function sweep() {
      if (root.getAttribute("data-pj-leak") !== "on" || doc.hidden || doc.querySelector("[data-harbor-player]")) return;
      if (!leak.isConnected) doc.body.append(leak);
      leak.setAttribute("data-run", leak.getAttribute("data-run") === "a" ? "b" : "a");
      clearTimeout(leakTimer);
      leakTimer = setTimeout(() => { leak.remove(); leak.removeAttribute("data-run"); }, 1200);
    }
    function onNav() {
      const v = activeView();
      if (!v || v === lastView) return;
      const first = lastView === null;
      lastView = v;
      if (!first) { part(); sweep(); }
    }
    const navObs = new MutationObserver(onNav);
    // Harbor unmounts the sidebar on Settings and during playback, so the observer follows it back on each scan.
    function watchAside() {
      const a = doc.querySelector("aside[data-harbor-sidebar]");
      if (a === watchedAside) return;
      navObs.disconnect();
      watchedAside = a;
      if (!a) return;
      navObs.observe(a, { subtree: true, attributes: true, attributeFilter: ["data-active"] });
      onNav();
    }

    hooks.apply.push(() => {
      // data-pj-perf is written first (js/50-tools.js puts its hook at the front).
      const lite = root.getAttribute("data-pj-perf") === "lite";
      setAttr("pj-beam", state.beam ? "on" : "off");
      setAttr("pj-curtain", state.curtain && motionOn() ? "on" : "off");
      setAttr("pj-brand", state.brand ? "on" : "off");
      setAttr("pj-bulbs", state.bulbs ? "on" : "off");
      setAttr("pj-leak", state.leak && motionOn() && !lite ? "on" : "off");
    });
    hooks.scan.push(watchAside);
    hooks.player.push((on) => { if (on) { clearTimeout(leakTimer); leak.remove(); clearTimeout(curtainTimer); curtain.remove(); } });
    hooks.dispose.push(() => { navObs.disconnect(); clearTimeout(leakTimer); leak.remove(); clearTimeout(curtainTimer); curtain.remove(); watchedAside = null; });
  }

  /* ===== js/90-start.js: start-up, test hook, cleanup ===== */

  /* ---------- start ---------- */
  apply();
  runScan();
  // One cheap DOM check every 1.5 s (skipped while hidden or during playback): banner slide changes and the
  // sidebar coming back. No animation runs from it.
  every(1500, runScan);
  listen(win, "harbor:scroll-top", () => setTimeout(runScan, 60));
  // Harbor sets data-chrome-hidden for the player, the play picker and Settings. The player itself is
  // [data-harbor-player]; on Windows the video can be a native layer behind the page, so modules hide their layers.
  let playerOn = false;
  const chromeObserver = new MutationObserver(() => {
    const on = !!doc.querySelector("[data-harbor-player]");
    if (on !== playerOn) { playerOn = on; runHooks(hooks.player, on); }
    setTimeout(runScan, 60);
  });
  chromeObserver.observe(root, { attributes: true, attributeFilter: ["data-chrome-hidden"] });
  cleanups.push(() => chromeObserver.disconnect());
  onMQ(lightMQ, () => { if (state.appearance === "windows") apply(); });
  onMQ(reduceMQ, apply);
  // "Follow time of day" re-checks every 15 minutes. apply() skips the write when nothing changed.
  every(15 * 60 * 1000, () => { if (state.appearance === "time" && !doc.hidden) apply(); });
  listen(doc, "visibilitychange", () => { if (!doc.hidden && state.appearance === "time") apply(); });

  // Test hook for the bench and the console. Not a public API.
  win.__projector = {
    version: VERSION,
    get settings() { return Object.assign({}, state); },
    set,
    fakeHour(h) { hourOverride = h == null ? null : clamp(Number(h), 0, 23.99); apply(); },
    setArtColor,
    stocks: Object.keys(STOCKS), types: Object.keys(TYPES),
  };

  /* ---------- cleanup ---------- */
  function dispose() {
    if (disposed) return;
    disposed = true;
    clearTimeout(saveTimer);
    store.set(KEY, JSON.stringify(state));
    cleanups.splice(0).forEach((f) => { try { f(); } catch (e) { /* keep going */ } });
    runHooks(hooks.dispose);
    [varsStyle, fontLink].forEach((n) => n.remove());
    ATTRS.forEach((k) => root.removeAttribute("data-" + k));
    delete win.__projector;
    if (win.__projectorDispose === dispose) delete win.__projectorDispose;
    if (win.__harborThemeCleanup === dispose) win.__harborThemeCleanup = undefined;
  }
  win.__projectorDispose = dispose;
  win.__harborThemeCleanup = dispose;
})();
